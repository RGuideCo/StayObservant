    outline-offset: 8px;
  }

  .project-content .flipbook-sheets,
  .project-content .flipbook-page {
    position: absolute;
    inset: 0;
  }

  .project-content .flipbook-sheets {
    z-index: 2;
    transform-style: preserve-3d;
  }

  .project-content .flipbook-page {
    z-index: 1;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    background: transparent;
    backface-visibility: hidden;
    transform-style: preserve-3d;
    will-change: transform, opacity, filter;
  }

  .project-content .flipbook-page.is-active {
    z-index: 2;
    opacity: 1;
    visibility: visible;
  }

  .project-content .flipbook-page:not(.is-cover)::after {
    content: "";
    position: absolute;
    inset: 0 auto 0 50%;
    z-index: 3;
    width: 3px;
    transform: translateX(-50%);
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.16), rgba(255, 255, 255, 0.55), rgba(0, 0, 0, 0.12));
    box-shadow: 0 0 22px rgba(0, 0, 0, 0.18);
