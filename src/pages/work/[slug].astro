  .project-lightbox__dialog {
    position: relative;
    display: grid;
    place-items: center;
    max-width: min(94vw, 1600px);
    max-height: 92vh;
    cursor: default;
  }

  .project-lightbox img {
    display: block;
    max-width: 100%;
    max-height: 88vh;
    width: auto;
    height: auto;
    background: #09090b;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
  }

  .project-lightbox__close {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
    display: grid;
    width: 3rem;
    height: 3rem;
    padding: 0;
    place-items: center;
    border: 0;
    background: #f4f1e9;
    color: #09090b;
    cursor: pointer;
    transition: background 180ms ease, color 180ms ease;
  }

  .project-lightbox__close:hover,
  .project-lightbox__close:focus-visible {
    background: #ff3b30;
    color: #fff;
  }

  .project-lightbox__close:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .project-lightbox__close .material-symbols-outlined {
    font-size: 1.5rem;
    font-variation-settings: "wght" 500;
  }

  @media (max-width: 1100px) {
    .case-hero-topline,
    .case-hero-bottom {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .case-hero-topline span {
      display: none;
    }

    .case-hero-bottom ul {
      justify-self: start;
    }

    .project-content .concept-split {
      grid-template-columns: 1fr;
    }

    .project-content .concept-copy {
      border-left: 0;
      border-top: 1px solid rgba(0, 0, 0, 0.14);
      padding-left: 0;
      padding-top: 1rem;
    }

    .project-content .model-horizontal .project-image-frame {
      flex-basis: min(78vw, 300px);
    }

    .project-content .model-horizontal .project-image-frame img {
      height: 156px;
    }

    .project-content .model-contact-sheet .project-image-frame img {
      height: calc(64px * var(--dock-scale));
    }

    .project-shell {
      display: block;
      gap: 0;
    }

    .project-toc {
      display: none;
    }

    .project-meta-strip {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  @media (max-width: 600px) {
    .case-hero {
      min-height: 23rem;
    }

    .project-hero-title {
      margin-bottom: 1.5rem;
      padding-inline: 1rem;
      font-size: clamp(2.65rem, 13.5vw, 5.5rem);
      white-space: nowrap;
    }

    .case-hero-topline,
    .case-hero-bottom {
      padding-inline: 1rem;
    }

    .case-hero-bottom ul {
      display: none;
    }

    .project-content .project-flipbook {
      margin-inline: 0;
      padding: 0 0 0.75rem;
    }

    .project-content .flipbook-header {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .project-content .flipbook-hint {
      display: none;
    }

    .project-content .flipbook-edge {
      --peel-size: 3.1rem;
      width: 24%;
    }

    .project-content .flipbook-controls {
      grid-template-columns: 2.6rem minmax(0, 1fr) 2.6rem;
      gap: 0.5rem;
    }

    .project-content .flipbook-control {
      width: 2.6rem;
      padding: 0;
    }

    .project-content .flipbook-control span:not([aria-hidden="true"]) {
      display: none;
    }

    .project-content .flipbook-progress {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.45rem;
    }

    .project-content .flipbook-page-title {
      grid-column: 1 / -1;
      grid-row: 1;
      font-size: 0.6rem;
    }

    .project-content .flipbook-dots,
    .project-content .flipbook-counter {
      grid-row: 2;
    }
  }
</style>

<script>
  import { PageFlip } from "page-flip";

  (() => {
    const init = () => {
      const content = document.querySelector(".project-content");
      if (!content) return;

      const slugify = (value) =>
        value
          .toLowerCase()
          .trim()
          .replace(/[^\w\s-]/g, "")
          .replace(/\s+/g, "-");

      const buildToc = () => {
        const tocList = document.querySelector("[data-project-toc]");
        if (!tocList) return;

        const headings = Array.from(content.querySelectorAll("h2, h3")).filter((h) =>
          h.textContent?.trim()
        );
        if (!headings.length) return;

        const seen = new Map();
        headings.forEach((heading) => {
          if (!heading.id) {
            const base = slugify(heading.textContent || "section");
            const count = seen.get(base) || 0;
            const nextCount = count + 1;
            seen.set(base, nextCount);
            heading.id = nextCount > 1 ? `${base}-${nextCount}` : base;
          }
        });

        const sections = [];
        let currentSection = null;
        headings.forEach((heading) => {
          if (heading.tagName === "H2") {
            currentSection = { heading, children: [] };
            sections.push(currentSection);
            return;
          }
          if (!currentSection) {
            currentSection = { heading, children: [] };
            sections.push(currentSection);
            return;
          }
          currentSection.children.push(heading);
        });

        tocList.innerHTML = "";
        const sectionEntries = [];
        const allLinks = [];

        sections.forEach((section) => {
          const li = document.createElement("li");
          li.className = "toc-section";

          const topLink = document.createElement("a");
          topLink.href = `#${section.heading.id}`;
          topLink.textContent = section.heading.textContent?.trim() || "";
          li.appendChild(topLink);

          const subList = document.createElement("ul");
          subList.className = "project-toc-sublist";

          const childLinks = section.children.map((child) => {
            const childItem = document.createElement("li");
            const childLink = document.createElement("a");
            childLink.href = `#${child.id}`;
            childLink.textContent = child.textContent?.trim() || "";
            childItem.appendChild(childLink);
            subList.appendChild(childItem);
            allLinks.push(childLink);
            return childLink;
          });

          if (section.children.length) {
            li.appendChild(subList);
          }

          allLinks.push(topLink);
          tocList.appendChild(li);
          sectionEntries.push({ section, li, topLink, childLinks });
        });

        const headingToSectionId = new Map();
        sections.forEach((section) => {
          headingToSectionId.set(section.heading.id, section.heading.id);
          section.children.forEach((child) => {
            headingToSectionId.set(child.id, section.heading.id);
          });
        });

        const updateActiveToc = () => {
          const offset = 150;
          let current = headings[0];
          headings.forEach((heading) => {
            if (heading.getBoundingClientRect().top - offset <= 0) {
              current = heading;
            }
          });

          const currentId = current?.id;
          const activeSectionId = headingToSectionId.get(currentId);

          allLinks.forEach((link) => {
            link.classList.toggle("is-active", link.getAttribute("href") === `#${currentId}`);
          });

          sectionEntries.forEach((entry) => {
            const isActiveSection = entry.section.heading.id === activeSectionId;
            entry.li.classList.toggle("is-expanded", isActiveSection);
            entry.topLink.classList.toggle(
              "is-active",
              isActiveSection || entry.topLink.getAttribute("href") === `#${currentId}`
            );

            const subList = entry.li.querySelector(".project-toc-sublist");
            if (!subList) return;
            subList.style.maxHeight = isActiveSection ? `${subList.scrollHeight}px` : "0px";
          });
        };

        window.addEventListener("scroll", updateActiveToc, { passive: true });
        window.addEventListener("resize", updateActiveToc);
        updateActiveToc();
      };

      buildToc();

      const images = content.querySelectorAll("p > img");
      images.forEach((img) => {
        if (img.closest(".project-image-frame")) return;

        const label = img.getAttribute("alt")?.trim() || "Project visual";
        const frame = document.createElement("span");
        frame.className = "project-image-frame";

        const bar = document.createElement("span");
        bar.className = "project-image-bar";
        bar.textContent = label;

        img.replaceWith(frame);
        frame.appendChild(img);
        frame.appendChild(bar);
      });

      // Build markdown-authored concept sections into a 50/50 slideshow + bullet panel.
      const buildConceptSplits = () => {
        const conceptHeads = Array.from(content.querySelectorAll("h2, h3, h4, h5")).filter(
          (h) => h.textContent.trim().toLowerCase() === "concept development"
        );

        conceptHeads.forEach((heading) => {
          if (heading.dataset.splitBuilt === "true") return;

          let cursor = heading.nextElementSibling;
          const sectionNodes = [];
          while (cursor && !["H2", "H3"].includes(cursor.tagName)) {
            sectionNodes.push(cursor);
            cursor = cursor.nextElementSibling;
          }

          const conceptPara =
            heading.nextElementSibling && heading.nextElementSibling.tagName === "P"
              ? heading.nextElementSibling
              : null;

          // Markdown often places consecutive images in one paragraph; collect up to 3 from there.
          let conceptImages = conceptPara
            ? Array.from(conceptPara.querySelectorAll("img"))
            : [];

          if (conceptImages.length < 3) {
            const fallbackImgs = sectionNodes
              .filter((el) => el.tagName === "P")
              .flatMap((el) => Array.from(el.querySelectorAll("img")));
            conceptImages = fallbackImgs;
          }
          conceptImages = conceptImages.slice(0, 3);
          if (conceptImages.length < 2) return;

          const principlesHeading = sectionNodes.find(
            (el) =>
              ["H4", "H5"].includes(el.tagName) &&
              el.textContent.trim().toLowerCase() === "design principles"
          );
          if (!principlesHeading) return;

          let principlesList = null;
          let listCursor = principlesHeading.nextElementSibling;
          while (listCursor && !["H2", "H3", "H4", "H5"].includes(listCursor.tagName)) {
            if (listCursor.tagName === "UL") {
              principlesList = listCursor;
              break;
            }
            listCursor = listCursor.nextElementSibling;
          }
          if (!principlesList) return;

          const split = document.createElement("section");
          split.className = "concept-split";
          split.setAttribute("data-scroll-slider", "");

          const left = document.createElement("div");
          const sliderMain = document.createElement("div");
          sliderMain.className = "concept-slider-main";

          const thumbs = document.createElement("div");
          thumbs.className = "concept-thumbs";
          thumbs.setAttribute("role", "tablist");
          thumbs.setAttribute("aria-label", "Concept drawing slideshow");

          conceptImages.forEach((sourceImg, index) => {
            const src = sourceImg.getAttribute("src") || "";
            const alt = sourceImg.getAttribute("alt") || `Concept drawing ${index + 1}`;

            const slide = document.createElement("div");
            slide.className = `concept-slide${index === 0 ? " is-active" : ""}`;
            slide.setAttribute("data-slide", "");

            const frame = document.createElement("span");
            frame.className = "project-image-frame";

            const img = document.createElement("img");
            img.src = src;
            img.alt = alt;

            const bar = document.createElement("span");
            bar.className = "project-image-bar";
            bar.textContent = `Concept Drawing 0${index + 1}`;

            frame.appendChild(img);
            frame.appendChild(bar);
            slide.appendChild(frame);
            sliderMain.appendChild(slide);

            const thumb = document.createElement("button");
            thumb.type = "button";
            thumb.setAttribute("data-thumb", "");
            thumb.setAttribute("aria-label", `Show concept drawing ${index + 1}`);
            if (index === 0) thumb.className = "is-active";

            const thumbImg = document.createElement("img");
            thumbImg.src = src;
            thumbImg.alt = `Thumbnail for concept drawing ${index + 1}`;
            thumb.appendChild(thumbImg);
            thumbs.appendChild(thumb);
          });

          left.appendChild(sliderMain);
          left.appendChild(thumbs);

          const right = document.createElement("aside");
          right.className = "concept-copy";
          const rightHeading = document.createElement("h3");
          rightHeading.textContent = principlesHeading.textContent.trim();
          right.appendChild(rightHeading);
          right.appendChild(principlesList.cloneNode(true));

          split.appendChild(left);
          split.appendChild(right);

          // Keep intro text paragraph if present, but remove the image nodes from it.
          if (conceptPara) {
            conceptImages.forEach((img) => {
              const wrapper = img.closest(".project-image-frame");
              if (wrapper) wrapper.remove();
              else img.remove();
            });
            if (conceptPara.nextSibling) {
              conceptPara.parentNode?.insertBefore(split, conceptPara.nextSibling);
            } else {
              conceptPara.parentNode?.appendChild(split);
            }
          } else {
            heading.parentNode?.insertBefore(split, heading.nextSibling);
          }

          principlesHeading.remove();
          principlesList.remove();
          heading.dataset.splitBuilt = "true";
        });
      };

      buildConceptSplits();

      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const rguideCounters = Array.from(content.querySelectorAll("[data-rguide-count]"));
      if (rguideCounters.length) {
        const numberFormatter = new Intl.NumberFormat("en-US");
        const revealCount = (counter) => {
          if (counter.dataset.counted === "true") return;

          const target = Number(counter.dataset.rguideCount);
          if (!Number.isFinite(target)) return;

          counter.dataset.counted = "true";
          if (prefersReduced) {
            counter.textContent = numberFormatter.format(target);
            return;
          }

          const startedAt = performance.now();
          const duration = 1100;
          counter.textContent = "0";

          const tick = (now) => {
            const progress = Math.min((now - startedAt) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            counter.textContent = numberFormatter.format(Math.round(target * eased));
            if (progress < 1) window.requestAnimationFrame(tick);
          };

          window.requestAnimationFrame(tick);
        };

        if ("IntersectionObserver" in window) {
          const counterObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                revealCount(entry.target);
                counterObserver.unobserve(entry.target);
              });
            },
            { threshold: 0.35 }
          );
          rguideCounters.forEach((counter) => counterObserver.observe(counter));
        } else {
          rguideCounters.forEach(revealCount);
        }
      }

      const rguideImpactStage = content.querySelector("[data-rguide-impact]");
      if (rguideImpactStage) {
        if ("IntersectionObserver" in window) {
          const impactObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                rguideImpactStage.classList.add("is-visible");
                impactObserver.disconnect();
              });
            },
            { threshold: 0.28 }
          );
          impactObserver.observe(rguideImpactStage);
        } else {
          rguideImpactStage.classList.add("is-visible");
        }
      }

      const rguideSchema = content.querySelector("[data-rguide-schema]");
      if (rguideSchema && !prefersReduced) {
        if ("IntersectionObserver" in window) {
          const schemaObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                rguideSchema.classList.add("is-visible");
                schemaObserver.disconnect();
              });
            },
            { threshold: 0.18 }
          );
          schemaObserver.observe(rguideSchema);
        } else {
          rguideSchema.classList.add("is-visible");
        }
      }

      const rguideTimeline = content.querySelector("[data-rguide-timeline]");
      if (rguideTimeline) {
        const phases = Array.from(rguideTimeline.querySelectorAll("[data-rguide-phase]"));
        const phaseNumber = rguideTimeline.querySelector("[data-rguide-phase-number]");
        const phaseTitle = rguideTimeline.querySelector("[data-rguide-phase-title]");
        const phaseCopy = rguideTimeline.querySelector("[data-rguide-phase-copy]");
        const phaseSystem = rguideTimeline.querySelector("[data-rguide-phase-system]");
        const track = rguideTimeline.querySelector(".rguide-timeline-track");
        let activeIndex = 0;
        let timer = null;
        let autoplayCancelled = prefersReduced;

        const stopTimeline = () => {
          if (!timer) return;
          window.clearInterval(timer);
          timer = null;
        };

        const showPhase = (index, shouldScroll = false) => {
          const nextIndex = Math.min(Math.max(index, 0), phases.length - 1);
          const phase = phases[nextIndex];
          if (!phase) return;

          activeIndex = nextIndex;
          phases.forEach((button, buttonIndex) => {
            button.setAttribute("aria-pressed", buttonIndex === activeIndex ? "true" : "false");
          });

          if (phaseNumber) phaseNumber.textContent = phase.dataset.phase || "";
          if (phaseTitle) phaseTitle.textContent = phase.dataset.title || "";
          if (phaseCopy) phaseCopy.textContent = phase.dataset.copy || "";
          if (phaseSystem) phaseSystem.textContent = phase.dataset.system || "";

          const progress = phases.length > 1 ? (activeIndex / (phases.length - 1)) * 100 : 100;
          rguideTimeline.style.setProperty("--rguide-progress", `${progress}%`);

          rguideTimeline.classList.remove("is-updating");
          void rguideTimeline.offsetWidth;
          rguideTimeline.classList.add("is-updating");

          if (shouldScroll && track && track.scrollWidth > track.clientWidth) {
            const targetLeft = phase.offsetLeft + phase.offsetWidth / 2 - track.clientWidth / 2;
            track.scrollTo({
              left: Math.max(0, targetLeft),
              behavior: prefersReduced ? "auto" : "smooth",
            });
          }
        };

        const startTimeline = () => {
          if (autoplayCancelled || timer || activeIndex >= phases.length - 1) return;
          timer = window.setInterval(() => {
            if (activeIndex >= phases.length - 1) {
              stopTimeline();
              return;
            }
            showPhase(activeIndex + 1, true);
          }, 1350);
        };

        phases.forEach((phase, index) => {
          phase.addEventListener("click", () => {
            autoplayCancelled = true;
            stopTimeline();
            showPhase(index, true);
          });
        });

        showPhase(0);

        if (!prefersReduced && "IntersectionObserver" in window) {
          const timelineObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.target !== rguideTimeline) return;
                if (entry.isIntersecting && entry.intersectionRatio >= 0.45) startTimeline();
                else stopTimeline();
              });
            },
            { threshold: [0.2, 0.45, 0.75] }
          );
          timelineObserver.observe(rguideTimeline);
        }
      }

      const rguideTraffic = content.querySelector("[data-rguide-traffic]");
      if (rguideTraffic) {
        const canvas = rguideTraffic.querySelector("[data-rguide-traffic-canvas]");
        const tooltip = rguideTraffic.querySelector("[data-rguide-traffic-tooltip]");
        const values = (rguideTraffic.dataset.points || "")
          .split(",")
          .map((value) => Number(value.trim()))
          .filter((value) => Number.isFinite(value));
        const labels = (rguideTraffic.dataset.labels || "").split(",");
        const requestedActualCount = Number(rguideTraffic.dataset.actualCount);
        const actualCount = Number.isFinite(requestedActualCount)
          ? Math.min(Math.max(Math.round(requestedActualCount), 2), values.length)
          : values.length;

        if (canvas instanceof HTMLCanvasElement && values.length > 1) {
          const context = canvas.getContext("2d");
          let chartProgress = prefersReduced ? 1 : 0;
          let animationFrame = 0;
          let renderedPoints = [];
          let hoveredIndex = -1;

          const drawTraffic = (progress = chartProgress) => {
            if (!context) return;

            const bounds = canvas.getBoundingClientRect();
            if (!bounds.width || !bounds.height) return;

            const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
            const pixelWidth = Math.round(bounds.width * pixelRatio);
            const pixelHeight = Math.round(bounds.height * pixelRatio);
            if (canvas.width !== pixelWidth || canvas.height !== pixelHeight) {
              canvas.width = pixelWidth;
              canvas.height = pixelHeight;
            }

            context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
            context.clearRect(0, 0, bounds.width, bounds.height);

            const compact = bounds.width < 560;
            const padding = {
              top: 18,
              right: 12,
              bottom: compact ? 30 : 34,
              left: compact ? 22 : 34,
            };
            const plotWidth = Math.max(bounds.width - padding.left - padding.right, 1);
            const plotHeight = Math.max(bounds.height - padding.top - padding.bottom, 1);
            const highestValue = Math.max(...values);
            const magnitude = Math.pow(10, Math.floor(Math.log10(Math.max(highestValue, 1))));
            const maximum = Math.ceil(highestValue / magnitude) * magnitude;
            const dotInterval = plotWidth / (values.length - 1);
            const styles = window.getComputedStyle(document.documentElement);
            const signal = styles.getPropertyValue("--signal").trim() || "#f03a22";
            const paper = styles.getPropertyValue("--paper").trim() || "#f2efe7";

            renderedPoints = values.map((value, index) => ({
              x: padding.left + dotInterval * index,
              y: padding.top + plotHeight - (value / maximum) * plotHeight,
              value,
              label: labels[index] || "",
            }));

            context.save();
            context.strokeStyle = "rgba(8, 8, 8, 0.14)";
            context.fillStyle = "rgba(8, 8, 8, 0.5)";
            context.lineWidth = 1;
            context.font = `700 ${compact ? 8 : 9}px Geist, Arial, sans-serif`;
            context.textBaseline = "middle";

            for (let index = 0; index <= 4; index += 1) {
              const y = padding.top + (plotHeight / 4) * index;
              const value = Math.round(maximum - (maximum / 4) * index);
              context.beginPath();
              context.moveTo(padding.left, y);
              context.lineTo(bounds.width - padding.right, y);
              context.stroke();
              if (!compact || index === 0 || index === 4) {
                context.fillText(String(value), 0, y);
              }
            }

            const labelIndexes = compact ? [0, 5, 10, 15, 19] : [0, 4, 8, 12, 15, 19];
            context.textBaseline = "alphabetic";
            labelIndexes.forEach((index) => {
              const point = renderedPoints[index];
              if (!point) return;
              const align = index === 0 ? "left" : index === values.length - 1 ? "right" : "center";
              context.textAlign = align;
              context.fillText(point.label, point.x, bounds.height - 5);
            });
            context.restore();

            const revealX = padding.left + plotWidth * Math.min(Math.max(progress, 0), 1);
            const observedPoints = renderedPoints.slice(0, actualCount);
            const projectedPoints = renderedPoints.slice(actualCount - 1);
            context.save();
            context.beginPath();
            context.rect(padding.left - 8, padding.top - 8, revealX - padding.left + 16, plotHeight + 16);
            context.clip();

            const areaGradient = context.createLinearGradient(0, padding.top, 0, padding.top + plotHeight);
            areaGradient.addColorStop(0, "rgba(240, 58, 34, 0.2)");
            areaGradient.addColorStop(1, "rgba(240, 58, 34, 0)");
            context.beginPath();
            context.moveTo(renderedPoints[0].x, padding.top + plotHeight);
            renderedPoints.forEach((point, index) => {
              if (index === 0) context.lineTo(point.x, point.y);
              else context.lineTo(point.x, point.y);
            });
            context.lineTo(renderedPoints[renderedPoints.length - 1].x, padding.top + plotHeight);
            context.closePath();
            context.fillStyle = areaGradient;
            context.fill();

            if (projectedPoints.length > 1) {
              const projectionFade = context.createLinearGradient(
                projectedPoints[0].x,
                0,
                projectedPoints[projectedPoints.length - 1].x,
                0
              );
              projectionFade.addColorStop(0, "rgba(0, 0, 0, 0)");
              projectionFade.addColorStop(0.72, "rgba(0, 0, 0, 0.5)");
              projectionFade.addColorStop(1, "rgba(0, 0, 0, 0.96)");

              context.save();
              context.globalCompositeOperation = "destination-out";
              context.beginPath();
              context.moveTo(projectedPoints[0].x, padding.top + plotHeight);
              projectedPoints.forEach((point, index) => {
                if (index === 0) context.lineTo(point.x, point.y);
                else context.lineTo(point.x, point.y);
              });
              context.lineTo(
                projectedPoints[projectedPoints.length - 1].x,
                padding.top + plotHeight
              );
              context.closePath();
              context.fillStyle = projectionFade;
              context.fill();
              context.restore();
            }

            context.beginPath();
            observedPoints.forEach((point, index) => {
              if (index === 0) context.moveTo(point.x, point.y);
              else context.lineTo(point.x, point.y);
            });
            context.strokeStyle = signal;
            context.lineWidth = 2;
            context.lineJoin = "round";
            context.lineCap = "round";
            context.stroke();

            if (projectedPoints.length > 1) {
              context.beginPath();
              projectedPoints.forEach((point, index) => {
                if (index === 0) context.moveTo(point.x, point.y);
                else context.lineTo(point.x, point.y);
              });
              context.setLineDash([7, 7]);
              context.strokeStyle = signal;
              context.lineWidth = 2;
              context.stroke();
              context.setLineDash([]);
            }
            context.restore();

            renderedPoints.forEach((point, index) => {
              const pointProgress = index / (renderedPoints.length - 1);
              if (pointProgress > progress + 0.025) return;

              const arrival = Math.min(Math.max((progress - pointProgress) * 16, 0), 1);
              const radius = (index === hoveredIndex ? 6 : 3.8) * (0.5 + arrival * 0.5);
              const isProjected = index >= actualCount;
              context.beginPath();
              context.arc(point.x, point.y, radius, 0, Math.PI * 2);
              context.fillStyle = isProjected ? paper : signal;
              context.fill();
              context.strokeStyle = signal;
              context.lineWidth = index === hoveredIndex ? 3 : 2;
              context.stroke();
            });
          };

          const startTrafficAnimation = () => {
            if (chartProgress >= 1 || prefersReduced) {
              chartProgress = 1;
              drawTraffic(1);
              return;
            }

            const startedAt = performance.now();
            const duration = 1800;
            const animate = (now) => {
              const elapsed = Math.min((now - startedAt) / duration, 1);
              chartProgress = 1 - Math.pow(1 - elapsed, 3);
