        const totalLabel = root.querySelector("[data-flipbook-total]");
        const pageTitle = root.querySelector("[data-flipbook-title]");
        const status = root.querySelector("[data-flipbook-status]");
        const coverButton = root.querySelector("[data-flipbook-cover]");
        const storyTitles = [
