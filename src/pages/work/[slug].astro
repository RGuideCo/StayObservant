                  { transform: "rotateY(-92deg) scaleX(0.92)", opacity: 0.94, filter: "brightness(0.7)", offset: 0.54 },
                  { transform: "rotateY(-180deg) scaleX(1)", opacity: 0, filter: "brightness(0.82)" },
                ]
