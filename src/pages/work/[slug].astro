          if (totalLabel) totalLabel.textContent = formatPageNumber(storyTitles.length);
          if (pageTitle) pageTitle.textContent = title;
          if (status) status.textContent = `Page ${storyIndex + 1} of ${storyTitles.length}: ${title}`;
