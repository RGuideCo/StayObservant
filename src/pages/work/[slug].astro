  }

  .project-content .project-flipbook .flipbook-page img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: contain;
    user-select: none;
    background: #fff;
    box-shadow:
      0 2px 3px rgba(24, 24, 27, 0.16),
      0 18px 35px rgba(24, 24, 27, 0.2),
      0 38px 70px rgba(24, 24, 27, 0.16);
  }

  .project-content .project-flipbook .flipbook-page.is-cover img {
    width: auto;
    max-width: 50%;
    margin-inline: auto;
  }

  .project-content .project-flipbook .flipbook-page.is-cover::before {
    content: "";
    position: absolute;
    z-index: 0;
    top: 0.38rem;
    right: calc(25% - 0.42rem);
    bottom: -0.42rem;
    left: calc(25% + 0.42rem);
    background: #e7e2da;
    box-shadow:
      3px 2px 0 #f8f5ef,
      7px 5px 0 #d4cec5,
      12px 10px 18px rgba(24, 24, 27, 0.18);
    opacity: 1;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .project-content .project-flipbook .flipbook-page.is-cover.is-cover-turning::before {
    opacity: 0;
  }

  .project-content .flipbook-turn-sheet {
    position: absolute;
    z-index: 5;
    top: 0;
    bottom: 0;
    width: 50%;
    transform-style: preserve-3d;
    will-change: transform, filter;
    pointer-events: none;
  }

  .project-content .flipbook-turn-sheet.is-forward {
    left: 50%;
    transform-origin: left center;
  }

  .project-content .flipbook-turn-sheet.is-backward {
    left: 0;
    transform-origin: right center;
  }

  .project-content .flipbook-turn-face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-color: #fff;
    background-repeat: no-repeat;
    background-size: 200% 100%;
    border-radius: inherit;
    backface-visibility: hidden;
  }

  .project-content .flipbook-turn-face::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(9, 9, 11, 0.28), transparent 16%, transparent 72%, rgba(255, 255, 255, 0.2));
    opacity: 0.62;
    pointer-events: none;
  }

  .project-content .flipbook-turn-face--back {
    transform: rotateY(180deg);
  }

  .project-content .flipbook-turn-sheet.is-forward .flipbook-turn-face--front,
  .project-content .flipbook-turn-sheet.is-backward .flipbook-turn-face--back {
    background-position: right center;
  }

  .project-content .flipbook-turn-sheet.is-forward .flipbook-turn-face--back,
  .project-content .flipbook-turn-sheet.is-backward .flipbook-turn-face--front {
    background-position: left center;
  }

  .project-content .flipbook-turn-sheet.is-backward .flipbook-turn-face::after {
    background: linear-gradient(270deg, rgba(9, 9, 11, 0.28), transparent 16%, transparent 72%, rgba(255, 255, 255, 0.2));
  }

  .project-content .flipbook-cover-turn {
    backface-visibility: hidden;
    transform-origin: left center;
    transform-style: preserve-3d;
    will-change: transform, opacity, filter;
  }

  .project-content .flipbook-edge {
    --peel-size: clamp(3.25rem, 7.5vw, 5.6rem);
    position: absolute;
    z-index: 6;
    top: 0;
    bottom: 0;
    width: 18%;
    padding: 0;
    color: #18181b;
    background: transparent;
    border: 0;
    cursor: pointer;
    overflow: visible;
    transition: right 420ms cubic-bezier(0.22, 1, 0.36, 1), left 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-content .flipbook-edge--prev {
    left: 0;
  }

  .project-content .flipbook-edge--next {
    right: 0;
  }

  .project-content .project-flipbook.is-cover-page .flipbook-edge--prev {
    left: 25%;
  }

  .project-content .project-flipbook.is-cover-page .flipbook-edge--next {
    right: 25%;
  }

  .project-content .flipbook-edge::before,
  .project-content .flipbook-edge::after {
    content: "";
    position: absolute;
    top: 0;
    width: var(--peel-size);
    height: var(--peel-size);
    opacity: 0;
    clip-path: polygon(100% 0, 0 0, 100% 100%);
    pointer-events: none;
    transition:
      opacity 240ms ease,
      transform 460ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 460ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-content .flipbook-edge::before {
    z-index: 1;
    background: rgba(0, 0, 0, 0.38);
    filter: blur(4px);
  }

  .project-content .flipbook-edge::after {
    z-index: 2;
    background: linear-gradient(225deg, #fff 0 38%, #f4f0e9 39% 52%, #ba1723 53% 56%, #d7d0c6 57% 72%, #8d867d 100%);
    filter: drop-shadow(-8px 10px 8px rgba(0, 0, 0, 0.34));
  }

  .project-content .flipbook-edge--next::before,
  .project-content .flipbook-edge--next::after {
    right: 0;
    transform: scale(0.08) rotate(2deg);
    transform-origin: 100% 0;
  }

  .project-content .flipbook-edge--prev::before,
  .project-content .flipbook-edge--prev::after {
    left: 0;
    clip-path: polygon(0 0, 100% 0, 0 100%);
    transform: scale(0.08) rotate(-2deg);
    transform-origin: 0 0;
  }

  .project-content .flipbook-edge:hover:not(:disabled)::before,
  .project-content .flipbook-edge:hover:not(:disabled)::after,
  .project-content .flipbook-edge:focus-visible:not(:disabled)::before,
  .project-content .flipbook-edge:focus-visible:not(:disabled)::after,
  .project-content .project-flipbook:not(.is-last-page) .flipbook-stage:hover .flipbook-edge--next:not(:disabled)::before,
  .project-content .project-flipbook:not(.is-last-page) .flipbook-stage:hover .flipbook-edge--next:not(:disabled)::after,
  .project-content .project-flipbook.is-last-page .flipbook-stage:hover .flipbook-edge--prev:not(:disabled)::before,
  .project-content .project-flipbook.is-last-page .flipbook-stage:hover .flipbook-edge--prev:not(:disabled)::after {
    opacity: 1;
    transform: scale(1) rotate(0deg);
