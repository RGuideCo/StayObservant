          "Deep in Detroit — Training Begins",
          "Metrics Recorded — The World Opens",
          "Relentless Training — Destination Brazil",
          "The Olympic Stage — Live Performance",
          "Gold — The Torch Is Passed",
        ];
        const storyPages = [0, 1, 3, 5, 7, 9];
        let storyIndex = 0;
        let controlsLocked = false;
        let coverAligning = false;

        const formatPageNumber = (value) => String(value).padStart(2, "0");
        const storyIndexForPage = (pageIndex) =>
          pageIndex === 0 ? 0 : Math.min(storyTitles.length - 1, Math.ceil(pageIndex / 2));

        const updateControls = () => {
          previousButtons.forEach((button) => {
            button.disabled = controlsLocked || storyIndex === 0;
          });
          nextButtons.forEach((button) => {
            button.disabled = controlsLocked || storyIndex === storyTitles.length - 1;
          });
