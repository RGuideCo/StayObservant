---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({
    params: { slug: p.slug },
  }));
}

const { slug } = Astro.params;
const projects = await getCollection("projects");
const entry = projects.find((p) => p.slug === slug);

if (!entry) {
  return new Response("Not found", { status: 404 });
}

const { Content } = await entry.render();
const project = entry.data;
---

<Layout title={project.title}>
  <header class="case-hero">
    <img
      src={project.hero ?? project.cover}
      alt={project.title}
      fetchpriority="high"
      decoding="async"
      class="case-hero-image"
    />
    <div class="case-hero-shade" aria-hidden="true"></div>

    <div class="case-hero-content">
      <div class="case-hero-topline">
        <a href="/#work">← Project index</a>
        <span>Case study / {project.role ?? "Design"}</span>
      </div>

      <h1 class="project-hero-title">
        {
          project.heroTitleLines?.length
            ? project.heroTitleLines.map((line, index) => (
                <>{index > 0 ? <br /> : null}{line}</>
              ))
            : project.title
        }
      </h1>

      <div class="case-hero-bottom">
        <p>{project.description}</p>
        {
          project.tags?.length ? (
            <ul>
              {project.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          ) : null
        }
      </div>
    </div>
  </header>

  <div class="case-body">
    <div class="container-page case-page">
      <section class="project-meta-strip" aria-label="Project metadata">
        {
          project.role ? (
            <div class="project-meta-item">
              <span class="project-meta-label">Role</span>
              <p class="project-meta-value">{project.role}</p>
            </div>
          ) : null
        }
        {
          project.tools?.length ? (
            <div class="project-meta-item">
              <span class="project-meta-label">Tools</span>
              <p class="project-meta-value">{project.tools.join(" · ")}</p>
            </div>
          ) : null
        }
        {
          project.deliverables?.length ? (
            <div class="project-meta-item">
              <span class="project-meta-label">Deliverables</span>
              <p class="project-meta-value">{project.deliverables.join(" · ")}</p>
            </div>
          ) : null
        }
      </section>

      <div class="project-shell">
        <article class="project-content">
          <Content />
        </article>

        <aside class="project-toc" aria-label="On this page">
          <p class="project-toc-title">On This Page</p>
          <nav>
            <ul class="project-toc-list" data-project-toc></ul>
          </nav>
        </aside>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  /* ===============================
     Layout Width (2/3 centered)
  =============================== */

  .project-content {
    max-width: 100%;
    margin: 0 auto;
    color: #18181b;
  }

  .project-hero-title {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.045em;
  }

  .case-hero {
    position: relative;
    min-height: calc(clamp(21rem, 36vh, 26rem) + 0.5rem);
    overflow: hidden;
    color: #fff;
    background: #111;
    border-bottom: var(--rule);
  }

  .case-hero-image,
  .case-hero-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .case-hero-image {
    object-fit: cover;
  }

  .case-hero-shade {
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0.16) 65%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.72), transparent 62%);
  }

  .case-hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    min-height: inherit;
    flex-direction: column;
    justify-content: space-between;
  }

  .case-hero-topline,
  .case-hero-bottom {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.55fr);
    gap: 2rem;
    padding: 1rem var(--page-gutter);
    border-bottom: 1px solid rgba(255, 255, 255, 0.42);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .case-hero-topline a {
    color: inherit;
    text-decoration: none;
  }

  .case-hero-topline span {
    text-align: right;
  }

  .project-hero-title {
    max-width: 10ch;
    margin: auto 0 1.5rem;
    padding: 1.5rem var(--page-gutter) 0;
    color: #fff;
    font-size: clamp(3.25rem, 7.4vw, 7.8rem);
    line-height: 0.82;
    text-transform: uppercase;
  }

  .case-hero-bottom {
    align-items: end;
    padding-block: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.42);
    border-bottom: 0;
  }

  .case-hero-bottom > p {
    max-width: 43rem;
    font-size: clamp(0.8rem, 1.2vw, 1rem);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0;
    text-transform: none;
  }

  .case-hero-bottom ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(255, 255, 255, 0.45);
    border-left: 1px solid rgba(255, 255, 255, 0.45);
  }

  .case-hero-bottom li {
    padding: 0.5rem 0.65rem;
    border-right: 1px solid rgba(255, 255, 255, 0.45);
    border-bottom: 1px solid rgba(255, 255, 255, 0.45);
    font-size: 0.56rem;
  }

  .case-body {
    color: var(--ink);
    background: var(--paper);
  }

  .case-page {
    padding-top: clamp(2.2rem, 5vw, 4.5rem);
    padding-bottom: clamp(4rem, 8vw, 8rem);
  }

  .project-shell {
    display: grid;
    grid-template-columns: minmax(9rem, 12rem) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1.6rem, 3vw, 3rem);
  }

  .project-shell .project-content {
    grid-column: 2;
    grid-row: 1;
  }

  .project-shell .project-toc {
    grid-column: 1;
    grid-row: 1;
    justify-self: stretch;
    width: auto;
    margin-right: 0;
  }

  .project-meta-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-bottom: clamp(2rem, 5vw, 4.5rem);
    border-top: var(--rule);
    border-left: var(--rule);
  }

  .project-meta-item {
    min-height: 6.2rem;
    padding: 1rem;
    background: transparent;
    border-right: var(--rule);
    border-bottom: var(--rule);
  }

  .project-meta-label {
    display: block;
    font-size: 0.66rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #71717a;
  }

  .project-meta-value {
    margin-top: 0.35rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: #27272a;
  }

  .project-toc {
    position: sticky;
    top: 1.3rem;
    padding: 0.2rem 0 0.2rem 0.9rem;
    border-radius: 0;
    background: transparent;
    border-left: 1px solid rgba(0, 0, 0, 0.16);
  }

  .project-toc-title {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #71717a;
  }

  .project-toc-list {
    list-style: none;
    margin: 0.8rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }

  .project-toc-list li {
    margin: 0;
    padding: 0;
  }

  .project-toc-list a {
    position: relative;
    display: block;
    padding: 0.14rem 0 0.14rem 0.4rem;
    text-decoration: none;
    color: #3f3f46;
    font-size: 0.78rem;
    line-height: 1.45;
    transition: color 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-toc-list .toc-section > a {
    font-weight: 600;
  }

  .project-toc-sublist {
    list-style: none;
    margin: 0.28rem 0 0 0;
    padding: 0 0 0 0.64rem;
    display: grid;
    gap: 0.16rem;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateY(-3px);
    transition:
      max-height 420ms cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 280ms ease,
      transform 320ms ease;
  }

  .project-toc-list .toc-section.is-expanded .project-toc-sublist {
    opacity: 1;
    transform: translateY(0);
  }

  .project-toc-sublist a {
    color: #71717a;
    font-size: 0.78rem;
  }

  .project-toc-list a:hover,
  .project-toc-list a.is-active {
    color: #09090b;
  }

  .project-toc-list a.is-active::before {
    content: "";
    position: absolute;
    top: 0.35rem;
    bottom: 0.35rem;
    left: -0.92rem;
    width: 2px;
    border-radius: 0;
    background: var(--signal);
  }

  /* ===============================
     Clean vertical rhythm
  =============================== */

  /* spacing between ALL top-level markdown blocks */
  .project-content > * + * {
    margin-top: 2rem;
  }

  /* Base body copy */
  .project-content p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.7;
    color: #3f3f46;
  }

  .project-content a {
    color: #18181b;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(0, 0, 0, 0.25);
    transition: text-decoration-color 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-content a:hover {
    text-decoration-color: rgba(0, 0, 0, 0.6);
  }

  /* Section headers */
  .project-content :is(h2, h3) {
    margin: 0;
    line-height: 1.2;
    letter-spacing: 0.01em;
    color: #09090b;
  }

  .project-content h2 {
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 2vw, 2.05rem);
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .project-content h3 {
    font-size: clamp(1.02rem, 1.25vw, 1.14rem);
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  /* Dividers before major sections for a cleaner scan */
  .project-content > h2:not(:first-child),
  .project-content > h3:not(:first-child) {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(0, 0, 0, 0.14);
  }

  .project-content :where(ul, ol) {
    margin: 0;
    padding-left: 1.25rem;
    color: #3f3f46;
    line-height: 1.65;
  }

  .project-content ul {
    list-style: disc;
  }

  .project-content ol {
    list-style: decimal;
  }

  .project-content :where(li + li) {
    margin-top: 0.5rem;
  }

  .project-content hr {
    display: none;
  }

  .project-content blockquote {
    margin: 0;
    padding: 1.25rem 1.25rem 1.35rem;
    border: 0;
    border-radius: 0;
    background: var(--signal);
    color: #fff;
  }

  .project-content blockquote p {
    color: #fff;
  }

  .project-content blockquote strong {
    color: #fff;
  }

  .project-content blockquote ul {
    position: relative;
    margin-top: 0.5rem;
    list-style: none;
    padding-left: 0;
    border-left: 0;
  }

  .project-content blockquote ul::before {
    content: "";
    position: absolute;
    top: 0.25rem;
    bottom: 0.25rem;
    left: 0.36rem;
    width: 2px;
    background: rgba(255, 255, 255, 0.45);
  }

  .project-content blockquote li {
    position: relative;
    margin-top: 1rem;
    padding-left: 1.35rem;
    color: rgba(255, 255, 255, 0.95);
    line-height: 1.6;
  }

  .project-content blockquote li::before {
    content: "";
    position: absolute;
    top: 0.4rem;
    left: 0;
    width: 0.74rem;
    height: 0.74rem;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.16);
  }

  .project-content blockquote li strong {
    display: block;
    margin-bottom: 0.15rem;
    color: #fff;
  }

  .project-content blockquote li a {
    display: inline-flex;
    align-items: center;
    margin: 0.2rem 0.45rem 0.2rem 0;
    padding: 0.34rem 0.72rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    color: #fff;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    transition:
      color 320ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 380ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 380ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-content blockquote li a:hover {
    background: #fff;
    color: #b1131a;
  }

  .project-content blockquote .timeline-group {
    display: inline-block;
    margin: 0.35rem 0 0.2rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .project-content blockquote .timeline-group--altruism {
    color: #fff;
    background: rgba(255, 255, 255, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.42);
  }

  .project-content blockquote .timeline-group--farm {
    color: #fff7e8;
    background: rgba(255, 198, 120, 0.2);
    border: 1px solid rgba(255, 212, 156, 0.62);
  }

  .project-content blockquote .timeline-link-row {
    display: block;
  }

  .project-content blockquote .timeline-link-row--farm a {
    border-color: rgba(255, 214, 161, 0.9);
    color: #fff0db;
    background: rgba(132, 72, 18, 0.34);
  }

  .project-content blockquote .timeline-link-row--farm a:hover {
    background: #ffd7a6;
    color: #7c3f00;
    border-color: #ffd7a6;
  }

  /* ===============================
     Image Handling (THE FIX)
  =============================== */

  /* All images behave like blocks */
  .project-content img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
    border: 0;
  }

  /* If image is wrapped in <p>, give it vertical space */
  .project-content p > img,
  .project-content p > .project-image-frame {
    margin: 2.5rem 0;
  }

  /* If markdown outputs consecutive images in SAME paragraph */
  .project-content img + img {
    margin-top: 2.5rem;
  }

  .project-content .project-image-frame {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 0;
    border: var(--rule);
  }

  .project-content .project-image-bar {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    align-items: center;
    min-height: 34px;
    padding: 0.4rem 0.75rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.96);
    background: rgba(10, 10, 12, 0.72);
    backdrop-filter: blur(3px);
    transform: translateY(105%);
    transition: transform 380ms cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  @media (hover: hover) {
    .project-content .project-image-frame:hover .project-image-bar,
    .project-content .project-image-frame:focus-within .project-image-bar {
      transform: translateY(0);
    }
  }

  /* If figures ever appear */
  .project-content figure {
    margin: 2.5rem 0;
  }

  .project-content figure + figure {
    margin-top: 2.5rem;
  }

  /* Joy Machine concept split section */
  .project-content .concept-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: center;
  }

  .project-content .concept-slider-main {
    position: relative;
    min-height: 320px;
  }

  .project-content .concept-slide {
    display: none;
  }

  .project-content .concept-slide.is-active {
    display: block;
  }

  .project-content .concept-slide .project-image-frame {
    margin: 0;
  }

  .project-content .concept-slide .project-image-bar {
    transform: translateY(0);
  }

  .project-content .concept-thumbs {
    margin-top: 0.75rem;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-content .concept-thumbs button {
    width: 56px;
    height: 56px;
    border: 1px solid rgba(0, 0, 0, 0.14);
    border-radius: 999px;
    overflow: hidden;
    background: #fff;
    padding: 0;
    cursor: pointer;
    transition:
      border-color 320ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-content .concept-thumbs button:hover {
    border-color: rgba(0, 0, 0, 0.45);
    transform: translateY(-1px);
  }

  .project-content .concept-thumbs button.is-active {
    border-color: rgba(0, 0, 0, 0.65);
  }

  .project-content .concept-thumbs img {
    margin: 0;
    border: 0;
    border-radius: 999px;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-content .concept-copy {
    border-left: 1px solid rgba(0, 0, 0, 0.14);
    padding-left: 1rem;
    align-self: center;
  }

  .project-content .concept-copy > h3 {
    font-size: clamp(1.05rem, 1.3vw, 1.2rem);
    text-transform: none;
  }

  .project-content .concept-copy ul {
    margin-top: 0.75rem;
    padding-left: 1rem;
    list-style: disc;
  }

  .project-content .concept-copy li {
    margin-top: 0.9rem;
    color: #3f3f46;
    line-height: 1.65;
  }

  .project-content .concept-copy li strong {
    display: block;
    margin-bottom: 0.25rem;
    color: #09090b;
  }

  .project-content .concept-copy h3 + p {
    margin-top: 0.6rem;
  }

  .project-content .concept-copy p + h3 {
    margin-top: 1.2rem;
  }

  .project-content .model-horizontal {
    position: relative;
    overflow: hidden;
    padding: 0.55rem 0.9rem 0.65rem;
    border-radius: 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(244, 240, 233, 0.85));
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .project-content .model-horizontal .filmstrip-track {
    display: flex;
    gap: 0;
    width: max-content;
    will-change: transform;
    animation: filmstrip-scroll var(--filmstrip-duration, 28s) linear infinite;
  }

  .project-content .model-horizontal::before,
  .project-content .model-horizontal::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 64px;
    z-index: 2;
    pointer-events: none;
  }

  .project-content .model-horizontal::before {
    left: 0;
    background: linear-gradient(to right, #f6f3ed 5%, rgba(246, 243, 237, 0));
  }

  .project-content .model-horizontal::after {
    right: 0;
    background: linear-gradient(to left, #f6f3ed 5%, rgba(246, 243, 237, 0));
  }

  .project-content .model-horizontal:hover .filmstrip-track,
  .project-content .model-horizontal:focus-within .filmstrip-track {
    animation-play-state: paused;
  }

  .project-content .model-horizontal .project-image-frame {
    flex: 0 0 min(56vw, 360px);
    max-width: 360px;
    min-width: 260px;
    margin: 0;
    cursor: pointer;
    border-radius: 0;
    border-left: 1px solid rgba(255, 255, 255, 0.24);
    border-right: 1px solid rgba(0, 0, 0, 0.06);
    transition:
      transform 380ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 380ms cubic-bezier(0.22, 1, 0.36, 1),
      z-index 380ms cubic-bezier(0.22, 1, 0.36, 1);
    transform-origin: center center;
  }

  .project-content .model-horizontal .project-image-frame img {
    width: 100%;
    height: 178px;
    object-fit: cover;
    transition: none;
  }

  .project-content .model-horizontal .project-image-frame:hover {
    transform: scale(1.045);
    z-index: 3;
    box-shadow: 0 16px 30px rgba(0, 0, 0, 0.24);
  }

  .project-content .model-slideshow {
    margin-top: 0;
    position: relative;
    padding-top: 1.6rem;
  }

  .project-content .model-build-block {
    margin-top: 0.65rem;
    padding: 1.2rem 1.1rem 1.3rem;
    border-radius: 0;
    background: #e7e3db;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .project-content .model-build-block > * + * {
    margin-top: 1rem;
  }

  .project-content .model-build-block .model-contact-sheet + .model-slideshow {
    margin-top: 0.45rem;
  }

  .project-content .model-block-title {
    margin: 0;
    text-align: center;
    font-size: clamp(1.1rem, 1.35vw, 1.28rem);
    font-weight: 700;
    text-transform: none;
  }

  .project-content .model-block-copy {
    margin-top: 0;
    text-align: center;
    color: #52525b;
  }

  .project-content .model-block-focus {
    margin-top: 0;
    text-align: center;
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    font-weight: 700;
    letter-spacing: 0.01em;
    color: #18181b;
  }

  .project-content .cfa-site-visit-video {
    margin: 1.25rem auto 0;
    max-width: 560px;
  }

  .project-content .cfa-site-visit-video video {
    display: block;
    width: 100%;
    max-height: min(78vh, 780px);
    object-fit: contain;
    background: #111;
  }

  .project-content .cfa-site-visit-video figcaption {
    margin-top: 0.55rem;
    text-align: center;
    color: #52525b;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-content .model-slide {
    display: none;
    margin: 0;
  }

  .project-content .model-slide.is-active {
    display: block;
  }

