        const pageFlip = new PageFlip(book, {
          width: 1275,
          height: 1650,
          size: "stretch",
          minWidth: 250,
          maxWidth: 650,
          minHeight: 324,
          maxHeight: 841,
          autoSize: true,
          usePortrait: true,
          showCover: true,
          showPageCorners: true,
          disableFlipByClick: true,
          drawShadow: true,
