  .project-content .flipbook-edge--next span {
    right: calc(var(--peel-size) * 0.2);
  }

  .project-content .flipbook-edge:hover:not(:disabled) span,
  .project-content .flipbook-edge:focus-visible:not(:disabled) span,
  .project-content .project-flipbook:not(.is-last-page) .flipbook-stage:hover .flipbook-edge--next:not(:disabled) span,
  .project-content .project-flipbook.is-last-page .flipbook-stage:hover .flipbook-edge--prev:not(:disabled) span {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }

  .project-content .flipbook-edge:disabled {
    cursor: default;
  }

  .project-content .flipbook-edge:focus-visible {
    outline: 0;
  }

