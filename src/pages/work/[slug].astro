        if (!slides.length || !thumbsWrap) return;

        let activeIndex = 0;
        const originalSlides = slides.map((slide) => {
          const img = slide.querySelector("img");
          const bar = slide.querySelector(".project-image-bar");
          return {
            src: img?.getAttribute("src") || "",
            alt: img?.getAttribute("alt") || "",
            label: bar?.textContent || "",
          };
        });

        const restoreSlide = (index) => {
          const slide = slides[index];
          const original = originalSlides[index];
          const img = slide?.querySelector("img");
          const bar = slide?.querySelector(".project-image-bar");
          if (img) {
            img.src = original.src;
            img.alt = original.alt;
          }
          if (bar) bar.textContent = original.label;
        };

        const thumbs = slides.map((slide, index) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "model-slide-thumb";
          btn.setAttribute("aria-label", `Show final model slide ${index + 1}`);
          btn.addEventListener("click", () => {
            show(index);
          });

          const sourceImg = slide.querySelector("img");
          const thumbImg = document.createElement("img");
          thumbImg.src = sourceImg?.getAttribute("src") || "";
          thumbImg.alt = `Thumbnail ${index + 1}`;
          btn.appendChild(thumbImg);

          thumbsWrap.appendChild(btn);
          return btn;
        });

        const show = (index) => {
          activeIndex = Math.min(Math.max(index, 0), slides.length - 1);
          restoreSlide(activeIndex);
          root.classList.remove("is-previewing");
          slides.forEach((slide, i) => slide.classList.toggle("is-active", i === activeIndex));
          thumbs.forEach((thumb, i) => thumb.classList.toggle("is-active", i === activeIndex));
        };

        root.addEventListener("model-preview", (event) => {
          if (!(event instanceof CustomEvent)) return;
          const detail = event.detail;
          if (!detail || typeof detail.src !== "string") return;

          const previewSlide = slides[0];
          const previewImg = previewSlide.querySelector("img");
          const previewBar = previewSlide.querySelector(".project-image-bar");
          if (!previewImg) return;

          previewImg.src = detail.src;
          previewImg.alt = typeof detail.alt === "string" ? detail.alt : "";
          if (previewBar) previewBar.textContent = typeof detail.label === "string" ? detail.label : "";

          activeIndex = 0;
          slides.forEach((slide, index) => slide.classList.toggle("is-active", index === 0));
          thumbs.forEach((thumb) => thumb.classList.remove("is-active"));
          root.classList.add("is-previewing");
        });

        show(0);
      });

      const horizontalCarousels = content.querySelectorAll(".model-horizontal");
      horizontalCarousels.forEach((carousel) => {
        if (carousel.dataset.filmstripBuilt === "true") return;
        const items = Array.from(carousel.querySelectorAll(":scope > .project-image-frame"));
        if (!items.length) return;

        const track = document.createElement("div");
        track.className = "filmstrip-track";

        items.forEach((item) => track.appendChild(item));
        items.forEach((item) => {
          const clone = item.cloneNode(true);
          clone.setAttribute("aria-hidden", "true");
          track.appendChild(clone);
        });

        carousel.innerHTML = "";
        carousel.appendChild(track);
        carousel.dataset.filmstripBuilt = "true";

        const updateFilmstripMetrics = () => {
          const distance = track.scrollWidth / 2;
          carousel.style.setProperty("--filmstrip-distance", `${distance}px`);
          const durationSeconds = Math.max(16, Math.round(distance / 70));
          carousel.style.setProperty("--filmstrip-duration", `${durationSeconds}s`);
        };

        updateFilmstripMetrics();
        if ("ResizeObserver" in window) {
          const ro = new ResizeObserver(updateFilmstripMetrics);
          ro.observe(carousel);
          ro.observe(track);
        } else {
          window.addEventListener("resize", updateFilmstripMetrics);
        }

        carousel.addEventListener("click", (event) => {
          const frame = event.target instanceof Element ? event.target.closest(".project-image-frame") : null;
          if (!frame || !carousel.contains(frame)) return;
          const img = frame.querySelector("img");
          if (!img) return;
          openLightbox(img.getAttribute("src") || "", img.getAttribute("alt") || "");
        });
      });

      const contactSheets = content.querySelectorAll(".model-contact-sheet");
      contactSheets.forEach((sheet) => {
        const frames = Array.from(sheet.querySelectorAll(".project-image-frame"));
        frames.forEach((frame) => {
          const img = frame.querySelector("img");
          frame.setAttribute("role", "button");
          frame.setAttribute("tabindex", "0");
          frame.setAttribute("aria-label", `Show ${img?.getAttribute("alt") || "model image"} in the large viewer`);
        });
        const resetDock = () => {
          frames.forEach((frame) => {
            frame.style.setProperty("--dock-scale", "1");
            frame.style.zIndex = "1";
            frame.style.boxShadow = "none";
          });
        };

        sheet.addEventListener("mousemove", (event) => {
          const pointerX = event.clientX;
          const maxDistance = 210;
          frames.forEach((frame) => {
            const rect = frame.getBoundingClientRect();
            const centerX = rect.left + rect.width / 2;
            const distance = Math.abs(pointerX - centerX);
            const normalized = Math.min(distance / maxDistance, 1);
            const influence = Math.cos((normalized * Math.PI) / 2) ** 2;
            const scale = 1 + influence * 0.52;
            frame.style.setProperty("--dock-scale", scale.toFixed(3));
            frame.style.boxShadow =
              influence > 0.06 ? "0 8px 16px rgba(0, 0, 0, 0.14)" : "none";
          });
        });

        sheet.addEventListener("mouseleave", resetDock);
        resetDock();

        sheet.addEventListener("click", (event) => {
          const frame = event.target instanceof Element ? event.target.closest(".project-image-frame") : null;
          if (!frame || !sheet.contains(frame)) return;
          const img = frame.querySelector("img");
          if (!img) return;
          const block = sheet.closest(".model-build-block");
          const slideshow = block?.querySelector("[data-model-slideshow]");
          if (!slideshow) return;
          const label = frame.querySelector(".project-image-bar")?.textContent || "";
          slideshow.dispatchEvent(
            new CustomEvent("model-preview", {
              detail: {
                src: img.getAttribute("src") || "",
                alt: img.getAttribute("alt") || "",
                label,
              },
            })
          );
          slideshow.scrollIntoView({
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
            block: "center",
          });
        });

        sheet.addEventListener("keydown", (event) => {
          if (event.key !== "Enter" && event.key !== " ") return;
          const frame = event.target instanceof Element ? event.target.closest(".project-image-frame") : null;
          if (!frame || !sheet.contains(frame)) return;
          event.preventDefault();
          frame.click();
        });
      });

      const lightbox = document.createElement("div");
      lightbox.className = "project-lightbox";
      lightbox.setAttribute("aria-hidden", "true");
      lightbox.setAttribute("role", "dialog");
      lightbox.setAttribute("aria-modal", "true");
      lightbox.setAttribute("aria-label", "Expanded project image");
      lightbox.innerHTML = `
        <div class="project-lightbox__dialog" role="document">
          <button type="button" class="project-lightbox__close" aria-label="Close expanded image">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
          </button>
          <img alt="" />
        </div>
      `;
      const lightboxImg = lightbox.querySelector("img");
      const lightboxClose = lightbox.querySelector(".project-lightbox__close");
      let activeLightboxTrigger = null;
      let previousBodyOverflow = "";
      document.body.appendChild(lightbox);

      const closeLightbox = () => {
        if (!lightbox.classList.contains("is-open")) return;
        lightbox.classList.remove("is-open");
        lightbox.setAttribute("aria-hidden", "true");
        document.body.style.overflow = previousBodyOverflow;
        if (lightboxImg) {
          lightboxImg.setAttribute("src", "");
          lightboxImg.setAttribute("alt", "");
        }
        if (activeLightboxTrigger instanceof HTMLElement) activeLightboxTrigger.focus();
        activeLightboxTrigger = null;
      };

      const openLightbox = (src, alt, trigger = null) => {
        if (!src || !lightboxImg) return;
        activeLightboxTrigger = trigger instanceof HTMLElement ? trigger : null;
        previousBodyOverflow = document.body.style.overflow;
        lightboxImg.setAttribute("src", src);
        lightboxImg.setAttribute("alt", alt || "Expanded project image");
        lightbox.classList.add("is-open");
        lightbox.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
        if (lightboxClose instanceof HTMLElement) lightboxClose.focus();
      };

      content.addEventListener("click", (event) => {
        const trigger = event.target instanceof Element
          ? event.target.closest("[data-project-lightbox-trigger]")
          : null;
        if (!trigger || !content.contains(trigger)) return;
        const img = trigger.querySelector("img");
        if (!img) return;
        openLightbox(img.getAttribute("src") || "", img.getAttribute("alt") || "", trigger);
      });

      lightbox.addEventListener("click", (event) => {
        if (event.target === lightbox) closeLightbox();
      });
      lightboxClose?.addEventListener("click", closeLightbox);
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && lightbox.classList.contains("is-open")) closeLightbox();
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
  })();
</script>
