                  { transform: "rotateY(-180deg) scaleX(1)", opacity: 0, filter: "brightness(0.82)" },
                  { transform: "rotateY(-88deg) scaleX(0.92)", opacity: 0.94, filter: "brightness(0.7)", offset: 0.46 },
                  { transform: "rotateY(-42deg) scaleX(0.98)", opacity: 1, filter: "brightness(0.9)", offset: 0.74 },
