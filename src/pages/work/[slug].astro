          storyIndex = storyIndexForPage(Number(pageIndex) || 0);
          root.classList.toggle("is-cover-page", storyIndex === 0);
          root.classList.toggle("is-last-page", storyIndex === storyTitles.length - 1);
          if (storyIndex !== 0) root.classList.remove("is-cover-opening");

