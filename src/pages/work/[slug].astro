      const pageFlipRoots = content.querySelectorAll("[data-flipbook]");
      pageFlipRoots.forEach((root) => {
        const book = root.querySelector("[data-pageflip-book]");
        const stage = root.querySelector("[data-flipbook-stage]");
        const leaves = Array.from(root.querySelectorAll(".flipbook-leaf"));
