---
const {
  title = "Stay Observant",
  primaryCtaText = "Experience",
  primaryCtaHref = "#cv",
  secondaryCtaText = "Contact",
  secondaryCtaHref = "#contact",
} = Astro.props;

const stats = [
  { value: 18, suffix: "+", label: "Years experience" },
  { value: 42, suffix: "+", label: "Clients" },
  { value: 120, suffix: "+", label: "Projects completed" },
];
---

<section class="hero" aria-labelledby="hero-title">
  <img
    src="/hero-bg.avif"
    alt=""
    fetchpriority="high"
    decoding="async"
    class="hero-image"
    aria-hidden="true"
  />
  <div class="hero-wash" aria-hidden="true"></div>

  <div class="hero-grid">
    <h1 id="hero-title">{title}</h1>

    <div class="hero-stats" aria-label="Studio statistics">
      {stats.map((stat) => (
        <div class="hero-stat" data-reveal>
          <strong>
            <span data-count data-to={stat.value} data-suffix={stat.suffix}>0</span>
          </strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </div>

    <div class="hero-actions">
      <a href={primaryCtaHref} class="hero-action hero-action-primary">
        <span>{primaryCtaText}</span>
        <span aria-hidden="true">↓</span>
      </a>
      <a href={secondaryCtaHref} class="hero-action hero-action-secondary">
        <span>{secondaryCtaText}</span>
        <span aria-hidden="true">↓</span>
      </a>
    </div>
  </div>

  <script>
    (() => {
      const init = () => {
        const counters = Array.from(document.querySelectorAll("[data-count]"));
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        const setFinalValues = () => {
          counters.forEach((counter) => {
            counter.textContent = `${counter.getAttribute("data-to") || "0"}${counter.getAttribute("data-suffix") || ""}`;
          });
        };

        if (reducedMotion) {
          setFinalValues();
          return;
        }

        const start = performance.now();
        const duration = 950;
        const animate = (now) => {
          const progress = Math.min(1, (now - start) / duration);
          const eased = 1 - Math.pow(1 - progress, 3);
          counters.forEach((counter) => {
            const end = Number(counter.getAttribute("data-to") || "0");
            const suffix = counter.getAttribute("data-suffix") || "";
            counter.textContent = `${Math.round(end * eased)}${suffix}`;
          });
          if (progress < 1) requestAnimationFrame(animate);
        };
        requestAnimationFrame(animate);
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init, { once: true });
      } else {
        init();
      }
    })();
  </script>
</section>

<style>
  .hero {
    position: relative;
    min-height: clamp(21rem, 36vh, 26rem);
    overflow: hidden;
    color: #fff;
    background: #181818;
    border-bottom: var(--rule);
  }

  .hero-image,
  .hero-wash {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-image {
    object-fit: cover;
    object-position: 50% 46%;
    filter: saturate(0.68) contrast(1.05);
    transform: scale(1.015);
  }

  .hero-wash {
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.76) 0%, rgba(0, 0, 0, 0.2) 58%, rgba(0, 0, 0, 0.48) 100%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.58) 0%, transparent 55%);
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(15rem, 0.7fr);
    grid-template-rows: 1fr auto;
    min-height: inherit;
  }

  h1 {
    align-self: center;
    max-width: 8ch;
    margin: 0;
    padding: clamp(1.75rem, 4vw, 3.5rem) var(--page-gutter);
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 7.4vw, 7.8rem);
    font-weight: 700;
    line-height: 0.73;
    letter-spacing: -0.09em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .hero-stats {
    display: grid;
    grid-template-rows: repeat(3, minmax(0, 1fr));
    align-self: stretch;
    border-left: 1px solid rgba(255, 255, 255, 0.42);
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.42);
  }

  .hero-stat:last-child {
    border-bottom: 0;
  }

  .hero-stat strong {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.5vw, 3.6rem);
    font-weight: 650;
    line-height: 0.85;
    letter-spacing: -0.07em;
  }

  .hero-stat > span {
    margin-top: 0.6rem;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .hero-actions {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.42);
  }

  .hero-action {
    display: flex;
    min-height: 4.4rem;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.25rem;
    color: #fff;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    transition:
      color 320ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 380ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-action:first-child {
    border-right: 1px solid rgba(255, 255, 255, 0.42);
  }

  .hero-action:hover,
  .hero-action:focus-visible {
    color: var(--ink);
    background: var(--signal);
    outline: none;
  }

  @media (max-width: 840px) {
    .hero-grid {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(11.5rem, 1fr) auto auto;
    }

    h1 {
      padding-bottom: 2.5rem;
      font-size: clamp(3.4rem, 14vw, 5.8rem);
    }

    .hero-stats {
      grid-template-rows: 1fr;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-top: 1px solid rgba(255, 255, 255, 0.42);
      border-left: 0;
    }

    .hero-stat {
      min-height: 6.5rem;
      border-right: 1px solid rgba(255, 255, 255, 0.42);
      border-bottom: 0;
    }

    .hero-stat:last-child {
      border-right: 0;
    }
  }

  @media (max-width: 520px) {
    .hero {
      min-height: 23rem;
    }

    h1 {
      padding-inline: 1rem;
      font-size: clamp(3rem, 13.5vw, 5rem);
    }

    .hero-stat {
      min-height: 5.35rem;
      padding: 0.8rem 0.65rem;
    }

    .hero-stat strong {
      font-size: 2rem;
    }

    .hero-stat > span {
      font-size: 0.5rem;
      line-height: 1.25;
    }

    .hero-action {
      min-height: 3.8rem;
      padding-inline: 1rem;
    }
  }
</style>
