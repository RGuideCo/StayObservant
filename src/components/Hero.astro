---
const {
  title = "Stay Observant",
  primaryCtaText = "Experience",
  primaryCtaHref = "#cv",
  secondaryCtaText = "Contact",
  secondaryCtaHref = "#contact",
} = Astro.props;

const stats = [
  { value: 18, suffix: "+", label: "Years experience" },
  { value: 42, suffix: "+", label: "Clients" },
  { value: 120, suffix: "+", label: "Projects completed" },
];

const titleWords = title.trim().split(/\s+/);
---

<section class="hero" aria-labelledby="hero-title">
  <img
    src="/hero-bg.avif"
    alt=""
    fetchpriority="high"
    decoding="async"
    class="hero-image"
    aria-hidden="true"
  />
  <div class="hero-wash" aria-hidden="true"></div>

  <div class="hero-grid">
    <h1 id="hero-title" aria-label={title}>
      {titleWords.map((word) => <span class="hero-title-word" aria-hidden="true">{word}</span>)}
    </h1>

    <div class="hero-stats" aria-label="Studio statistics">
      {stats.map((stat) => (
        <div class="hero-stat" data-reveal>
          <strong>
            <span data-count data-to={stat.value} data-suffix={stat.suffix}>0</span>
          </strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </div>

    <div class="hero-actions">
      <a href={primaryCtaHref} class="hero-action hero-action-primary">
        <span>{primaryCtaText}</span>
        <span aria-hidden="true">↓</span>
      </a>
      <a href={secondaryCtaHref} class="hero-action hero-action-secondary">
        <span>{secondaryCtaText}</span>
        <span aria-hidden="true">↓</span>
      </a>
    </div>
  </div>

  <script>
    (() => {
      let counterAnimationStarted = false;

      const hero = document.querySelector(".hero");
      let heroExpansionFinished = false;
      const announceHeroExpanded = () => {
        if (heroExpansionFinished) return;
        heroExpansionFinished = true;
        document.documentElement.classList.add("is-hero-expanded");
        window.dispatchEvent(new CustomEvent("hero:expanded"));
      };

      const onHeroTransitionEnd = (event) => {
        if (event.target !== hero || event.propertyName !== "height") return;
        hero?.removeEventListener("transitionend", onHeroTransitionEnd);
        announceHeroExpanded();
      };

      hero?.addEventListener("transitionend", onHeroTransitionEnd);

      const armHeroExpansionFallback = () => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) announceHeroExpanded();
        else window.setTimeout(announceHeroExpanded, 1000);
      };

      if (document.documentElement.classList.contains("is-page-ready")) armHeroExpansionFallback();
      else window.addEventListener("site:ready", armHeroExpansionFallback, { once: true });

      const init = () => {
        if (counterAnimationStarted) return;
        counterAnimationStarted = true;
        const counters = Array.from(document.querySelectorAll("[data-count]"));
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        const setFinalValues = () => {
          counters.forEach((counter) => {
            counter.textContent = `${counter.getAttribute("data-to") || "0"}${counter.getAttribute("data-suffix") || ""}`;
          });
        };

        if (reducedMotion) {
          setFinalValues();
          return;
        }

        const start = performance.now();
        const duration = 950;
        const animate = (now) => {
          const progress = Math.min(1, (now - start) / duration);
          const eased = 1 - Math.pow(1 - progress, 3);
          counters.forEach((counter) => {
            const end = Number(counter.getAttribute("data-to") || "0");
            const suffix = counter.getAttribute("data-suffix") || "";
            counter.textContent = `${Math.round(end * eased)}${suffix}`;
          });
          if (progress < 1) requestAnimationFrame(animate);
        };
        requestAnimationFrame(animate);
      };

      const startAfterStatReveal = () => {
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let heroRevealFinished = false;
        const finishHeroReveal = () => {
          if (heroRevealFinished) return;
          heroRevealFinished = true;
          document.documentElement.classList.add("is-hero-ready");
          window.dispatchEvent(new CustomEvent("hero:revealed"));
          init();
        };

        if (reducedMotion) {
          finishHeroReveal();
          return;
        }

        const finalStat = document.querySelector(".hero-stat:last-child");
        const fallback = window.setTimeout(finishHeroReveal, 1900);
        const onRevealFinished = (event) => {
          if (event.propertyName !== "transform") return;
          finalStat?.removeEventListener("transitionend", onRevealFinished);
          window.clearTimeout(fallback);
          finishHeroReveal();
        };
        finalStat?.addEventListener("transitionend", onRevealFinished);
      };

      if (document.documentElement.classList.contains("is-page-ready")) startAfterStatReveal();
      else window.addEventListener("site:ready", startAfterStatReveal, { once: true });
    })();
  </script>
</section>

<style>
  .hero {
    --hero-height: clamp(24rem, 48vh, 32rem);
    position: relative;
    height: var(--hero-height);
    min-height: 0;
    overflow: hidden;
    color: #fff;
    background: var(--paper);
    border-bottom: var(--rule);
    transition:
      height 850ms cubic-bezier(0.76, 0, 0.24, 1),
      border-color 180ms ease;
  }

  .hero-image,
  .hero-wash {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-image {
    object-fit: cover;
    object-position: 50% 46%;
    filter: saturate(0.68) contrast(1.05);
    transform: scale(1.015);
    transition:
      clip-path 850ms cubic-bezier(0.76, 0, 0.24, 1),
      transform 1050ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-wash {
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.76) 0%, rgba(0, 0, 0, 0.2) 58%, rgba(0, 0, 0, 0.48) 100%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.58) 0%, transparent 55%);
    transition: clip-path 850ms cubic-bezier(0.76, 0, 0.24, 1);
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(15rem, 0.7fr);
    grid-template-rows: 1fr auto;
    height: 100%;
    min-height: 0;
  }

  :global(html.has-js.is-page-loading) .hero {
    height: 0;
    border-bottom-color: transparent;
  }

  :global(html.has-js.is-page-ready) .hero {
    height: var(--hero-height);
    border-bottom-color: var(--ink);
  }

  h1 {
    align-self: center;
    max-width: 8ch;
    margin: 0;
    padding: clamp(1.75rem, 4vw, 3.5rem) var(--page-gutter);
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 6.8vw, 7.2rem);
    font-weight: 700;
    line-height: 0.82;
    letter-spacing: -0.09em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .hero-title-word {
    display: block;
    width: max-content;
    padding-right: 0.08em;
    transition:
      opacity 720ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 820ms cubic-bezier(0.22, 1, 0.36, 1),
      clip-path 820ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-stats {
    position: relative;
    display: grid;
    grid-template-rows: repeat(3, minmax(0, 1fr));
    align-self: stretch;
  }

  .hero-stats::before,
  .hero-stat::after,
  .hero-actions::before,
  .hero-action:first-child::after {
    position: absolute;
    z-index: 3;
    display: block;
    content: "";
    pointer-events: none;
    background: rgba(255, 255, 255, 0.42);
  }

  .hero-stats::before {
    inset: 0 auto 0 0;
    width: 1px;
    transform: scaleY(1);
    transform-origin: center;
  }

  .hero-stat {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
    padding: 0.85rem 1.25rem;
    transition:
      opacity 620ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 720ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-stat:not(:last-child)::after {
    inset: auto 0 0;
    height: 1px;
    transform: scaleX(1);
    transform-origin: left;
  }

  .hero-stat strong {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.5vw, 3.6rem);
    font-weight: 650;
    line-height: 0.85;
    letter-spacing: -0.07em;
  }

  .hero-stat > span {
    margin-top: 0.6rem;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .hero-actions {
    position: relative;
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hero-actions::before {
    inset: 0 0 auto;
    height: 1px;
    transform: scaleX(1);
    transform-origin: center;
  }

  :global(html.has-js.is-page-loading) .hero-image,
  :global(html.has-js.is-page-loading) .hero-wash {
    clip-path: inset(50% 0 50%);
  }

  :global(html.has-js.is-page-loading) .hero-image {
    transform: scale(1.06);
  }

  :global(html.has-js.is-page-loading) .hero-title-word,
  :global(html.has-js.is-page-loading) .hero-stat,
  :global(html.has-js.is-page-loading) .hero-action > span {
    opacity: 0;
    clip-path: inset(100% 0 0);
    transform: translateY(1.4rem);
  }

  :global(html.has-js.is-page-loading) .hero-stats::before,
  :global(html.has-js.is-page-loading) .hero-action:first-child::after {
    transform: scaleY(0);
  }

  :global(html.has-js.is-page-loading) .hero-stat::after,
  :global(html.has-js.is-page-loading) .hero-actions::before {
    transform: scaleX(0);
  }

  :global(html.has-js.is-page-ready) .hero-image,
  :global(html.has-js.is-page-ready) .hero-wash {
    clip-path: inset(0);
  }

  :global(html.has-js.is-page-ready) .hero-title-word,
  :global(html.has-js.is-page-ready) .hero-stat,
  :global(html.has-js.is-page-ready) .hero-action > span {
    opacity: 1;
    clip-path: inset(0);
    transform: translateY(0);
  }

  :global(html.has-js.is-page-ready) .hero-image {
    transform: scale(1.015);
  }

  :global(html.has-js.is-page-ready) .hero-title-word:nth-child(1) { transition-delay: 820ms; }
  :global(html.has-js.is-page-ready) .hero-title-word:nth-child(2) { transition-delay: 880ms; }

  :global(html.has-js.is-page-ready) .hero-stats::before {
    animation: draw-vertical-line 520ms 800ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  :global(html.has-js.is-page-ready) .hero-stat:nth-child(1) { transition-delay: 900ms; }
  :global(html.has-js.is-page-ready) .hero-stat:nth-child(2) { transition-delay: 960ms; }
  :global(html.has-js.is-page-ready) .hero-stat:nth-child(3) { transition-delay: 1020ms; }

  :global(html.has-js.is-page-ready) .hero-stat:nth-child(1)::after {
    animation: draw-horizontal-line 480ms 860ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  :global(html.has-js.is-page-ready) .hero-stat:nth-child(2)::after {
    animation: draw-horizontal-line 480ms 920ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  :global(html.has-js.is-page-ready) .hero-actions::before {
    animation: draw-horizontal-line 580ms 820ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  :global(html.has-js.is-page-ready) .hero-action:first-child::after {
    animation: draw-vertical-line 440ms 950ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-action {
    position: relative;
    display: flex;
    min-height: 4.4rem;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.25rem;
    color: #fff;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    transition:
      color 320ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 380ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-action > span {
    transition:
      opacity 560ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 640ms cubic-bezier(0.22, 1, 0.36, 1),
      clip-path 640ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(html.has-js.is-page-ready) .hero-action:first-child > span { transition-delay: 1030ms; }
  :global(html.has-js.is-page-ready) .hero-action:last-child > span { transition-delay: 1090ms; }

  .hero-action:first-child {
    border-right: 0;
  }

  .hero-action:first-child::after {
    inset: 0 0 0 auto;
    width: 1px;
    transform: scaleY(1);
    transform-origin: center;
  }

  .hero-action:hover,
  .hero-action:focus-visible {
    color: var(--ink);
    background: var(--signal);
    outline: none;
  }

  @keyframes draw-horizontal-line {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  @keyframes draw-vertical-line {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }

  @media (max-width: 840px) {
    .hero-grid {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(11.5rem, 1fr) auto auto;
    }

    h1 {
      padding-bottom: 2.5rem;
      font-size: clamp(3.4rem, 14vw, 5.8rem);
    }

    .hero-stats {
      grid-template-rows: 1fr;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .hero-stats::before {
      inset: 0 0 auto;
      width: auto;
      height: 1px;
      transform: scaleX(1);
    }

    .hero-stat {
      min-height: 6.5rem;
    }

    .hero-stat:not(:last-child)::after {
      inset: 0 0 0 auto;
      width: 1px;
      height: auto;
      transform: scaleY(1);
      transform-origin: center;
    }

    :global(html.has-js.is-page-loading) .hero-stats::before {
      transform: scaleX(0);
    }

    :global(html.has-js.is-page-loading) .hero-stat::after {
      transform: scaleY(0);
    }

    :global(html.has-js.is-page-ready) .hero-stats::before,
    :global(html.has-js.is-page-ready) .hero-stat:nth-child(1)::after,
    :global(html.has-js.is-page-ready) .hero-stat:nth-child(2)::after {
      animation-name: draw-horizontal-line;
    }

    :global(html.has-js.is-page-ready) .hero-stat:nth-child(1)::after,
    :global(html.has-js.is-page-ready) .hero-stat:nth-child(2)::after {
      animation-name: draw-vertical-line;
    }
  }

  @media (max-width: 520px) {
    .hero {
      --hero-height: 23rem;
    }

    h1 {
      padding-inline: 1rem;
      font-size: clamp(3rem, 13.5vw, 5rem);
    }

    .hero-stat {
      min-height: 5.35rem;
      padding: 0.8rem 0.65rem;
    }

    .hero-stat strong {
      font-size: 2rem;
    }

    .hero-stat > span {
      font-size: 0.5rem;
      line-height: 1.25;
    }

    .hero-action {
      min-height: 3.8rem;
      padding-inline: 1rem;
    }
  }
</style>
