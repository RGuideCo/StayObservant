---
import logoSvg from "../assets/Logo.svg?raw";

const isHome = Astro.url.pathname === "/";
const sectionHref = (section) => isHome ? `#${section}` : `/#${section}`;

const navigation = [
  { label: "Work", href: sectionHref("work"), icon: "work" },
  { label: "Sketchbook", href: sectionHref("sketchbook"), icon: "sketchbook" },
  { label: "Capabilities", href: sectionHref("capabilities"), icon: "capabilities" },
  { label: "CV", href: sectionHref("cv"), icon: "cv" },
  { label: "Contact", href: sectionHref("contact"), icon: "contact" },
];

const icons = {
  contact: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" stroke-linejoin="miter"><rect x="3" y="5" width="18" height="14"/><path d="m4 7 8 6 8-6"/></svg>',
  work: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>',
  cv: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" stroke-linejoin="miter"><path d="M6 2h8l4 4v16H6z"/><path d="M14 2v5h5M9 12h6M9 16h6"/></svg>',
  capabilities: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"><circle cx="12" cy="12" r="3"/><path d="M12 2v5M12 17v5M2 12h5M17 12h5M4.9 4.9l3.5 3.5M15.6 15.6l3.5 3.5M19.1 4.9l-3.5 3.5M8.4 15.6l-3.5 3.5"/></svg>',
  sketchbook: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" stroke-linejoin="miter"><path d="M4 3h13v18H4zM8 3v18"/><path d="m12 15 6.7-6.7 2 2L14 17l-3 .8z"/></svg>',
};
---

<aside class="site-sidebar" aria-label="Primary navigation">
  <a class="sidebar-brand" href="/" aria-label="Stay Observant home">
    <span class="sidebar-mark" set:html={logoSvg} aria-hidden="true"></span>
  </a>

  <nav class="sidebar-nav" aria-label="Site sections">
    {navigation.map((item) => (
      <a
        class:list={["sidebar-nav-link", !isHome && item.icon === "work" && "is-active"]}
        href={item.href}
        data-sidebar-section={item.icon}
        aria-label={item.label}
        aria-current={!isHome && item.icon === "work" ? "location" : undefined}
        title={item.label}
        target={item.external ? "_blank" : undefined}
        rel={item.external ? "noopener" : undefined}
      >
        <span class="sidebar-nav-icon" set:html={icons[item.icon]} aria-hidden="true"></span>
        <span class="visually-hidden">{item.label}</span>
      </a>
    ))}
  </nav>

  <script>
    (() => {
      const links = Array.from(document.querySelectorAll("[data-sidebar-section]"));
      const sections = links
        .map((link) => document.getElementById(link.getAttribute("data-sidebar-section") || ""))
        .filter(Boolean);

      if (!sections.length) return;

      const setActive = (sectionId) => {
        links.forEach((link) => {
          const isActive = link.getAttribute("data-sidebar-section") === sectionId;
          link.classList.toggle("is-active", isActive);
          if (isActive) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        });
      };

      const updateActiveSection = () => {
        const activationLine = Math.min(window.innerHeight * 0.38, 260);
        const activeSection = sections.find((section) => {
          const bounds = section.getBoundingClientRect();
          return bounds.top <= activationLine && bounds.bottom > activationLine;
        });

        setActive(activeSection?.id || "");
      };

      links.forEach((link) => {
        link.addEventListener("click", () => setActive(link.getAttribute("data-sidebar-section") || ""));
      });

      window.addEventListener("scroll", updateActiveSection, { passive: true });
      window.addEventListener("resize", updateActiveSection);
      requestAnimationFrame(updateActiveSection);
    })();
  </script>
</aside>

<style>
  .site-sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 50;
    display: flex;
    width: var(--sidebar-width);
    flex-direction: column;
    color: #f4f0e7;
    background: #080808;
  }

  .sidebar-brand {
    display: flex;
    min-height: 6.5rem;
    align-items: center;
    justify-content: center;
    padding: 1.35rem 1.25rem;
    color: inherit;
    text-decoration: none;
  }

  .sidebar-mark {
    display: block;
    width: 4.25rem;
    height: 4.25rem;
    flex: none;
  }

  :global(html.has-js.is-page-loading) .sidebar-mark,
  :global(html.has-js.is-page-loading) .sidebar-nav-link {
    opacity: 0;
    transform: scale(0.45);
  }

  :global(html.has-js.is-page-ready) .sidebar-mark,
  :global(html.has-js.is-page-ready) .sidebar-nav-link {
    animation: toolbar-pop 440ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  :global(html.has-js.is-page-ready) .sidebar-mark { animation-delay: 60ms; }
  :global(html.has-js.is-page-ready) .sidebar-nav-link:nth-child(1) { animation-delay: 125ms; }
  :global(html.has-js.is-page-ready) .sidebar-nav-link:nth-child(2) { animation-delay: 175ms; }
  :global(html.has-js.is-page-ready) .sidebar-nav-link:nth-child(3) { animation-delay: 225ms; }
  :global(html.has-js.is-page-ready) .sidebar-nav-link:nth-child(4) { animation-delay: 275ms; }
  :global(html.has-js.is-page-ready) .sidebar-nav-link:nth-child(5) { animation-delay: 325ms; }

  @keyframes toolbar-pop {
    0% { opacity: 0; transform: scale(0.45); }
    72% { opacity: 1; transform: scale(1.12); }
    100% { opacity: 1; transform: scale(1); }
  }

  .sidebar-mark :global(svg) {
    width: 100%;
    height: 100%;
  }

  .sidebar-nav {
    display: grid;
    gap: 0.2rem;
    padding: 0.35rem 0;
  }

  .sidebar-nav-link {
    display: grid;
    min-height: 4.2rem;
    place-items: center;
    padding: 0.6rem;
    color: inherit;
    text-decoration: none;
  }

  .sidebar-nav-link:focus-visible {
    outline: none;
  }

  .sidebar-nav-link:hover .sidebar-nav-icon,
  .sidebar-nav-link:focus-visible .sidebar-nav-icon,
  .sidebar-nav-link.is-active .sidebar-nav-icon {
    color: #080808;
    background: var(--signal);
    transform: scale(1.06);
  }

  .sidebar-nav-link:focus-visible .sidebar-nav-icon {
    outline: 2px solid #f4f0e7;
    outline-offset: 3px;
  }

  .sidebar-nav-icon {
    display: grid;
    width: 2.8rem;
    height: 2.8rem;
    place-items: center;
    color: inherit;
    background: transparent;
    transition:
      color 280ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 340ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 340ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .sidebar-nav-icon :global(svg) {
    display: block;
    width: 1.45rem;
    height: 1.45rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 760px) {
    .site-sidebar {
      inset: 0 0 auto;
      display: grid;
      grid-template-columns: var(--mobile-header-height) minmax(0, 1fr);
      width: 100%;
      height: var(--mobile-header-height);
    }

    .sidebar-brand {
      min-height: 0;
      height: var(--mobile-header-height);
      padding: 0.65rem;
    }

    .sidebar-mark {
      width: 2.35rem;
      height: 2.35rem;
    }

    .sidebar-nav {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      height: var(--mobile-header-height);
      gap: 0;
      padding: 0;
    }

    .sidebar-nav-link {
      min-height: 0;
      padding: 0.55rem;
    }

    .sidebar-nav-icon {
      width: 2.45rem;
      height: 2.45rem;
    }

    .sidebar-nav-icon :global(svg) {
      width: 1.25rem;
      height: 1.25rem;
    }
  }
</style>
