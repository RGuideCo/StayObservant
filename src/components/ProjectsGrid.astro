---
import { getCollection } from "astro:content";

const entries = await getCollection("projects");
const preferredOrder = ["rguide", "chick-fil-a", "boca-paila", "chobani", "sidestreat", "3m-home-depot", "morgans", "nike-ko"];
const projects = entries
  .map((entry) => ({ slug: entry.slug, ...entry.data }))
  .sort((a, b) => {
    const aIndex = preferredOrder.indexOf(a.slug);
    const bIndex = preferredOrder.indexOf(b.slug);
    return (aIndex === -1 ? preferredOrder.length : aIndex)
      - (bIndex === -1 ? preferredOrder.length : bIndex);
  });

const filterTags = [
  "UI/UX",
  "Branding",
  "Retail",
  "Industrial Design",
  "Illustration",
  "Experience Design",
  "Advertising",
];
---

<section id="work" class="work-section" aria-label="Selected work">
  <header class="work-header">
    <div class="filter-group">
      <div class="project-filters" data-project-filters aria-label="Filter projects">
        <button type="button" class="project-filter-btn is-active" data-filter="all">All</button>
        {filterTags.map((tag) => (
          <button type="button" class="project-filter-btn" data-filter={tag.toLowerCase()}>{tag}</button>
        ))}
      </div>
    </div>
  </header>

  <div class="projects-grid">
    {projects.map((project, index) => (
      <a
        href={`/work/${project.slug}`}
        data-project-card
        data-project-slug={project.slug}
        data-project-tags={(project.tags || []).map((tag) => tag.toLowerCase()).join("|")}
        class="project-card"
      >
        <picture>
          {project.mobileCover && (
            <source media="(max-width: 600px)" srcset={project.mobileCover} />
          )}
          <img
            src={project.cover}
            alt={project.title}
            loading={index < 3 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : "auto"}
            decoding="async"
          />
        </picture>
        <span class="project-shade" aria-hidden="true"></span>
        <div class="project-label">
          <div class="project-label-heading">
            <h3>{project.title}</h3>
            <span class="project-open" aria-hidden="true">↗</span>
          </div>
          <div class="project-detail">
            <p>{project.description}</p>
            <dl>
              <div>
                <dt>Role</dt>
                <dd>{project.role ?? "Design"}</dd>
              </div>
              <div>
                <dt>Field</dt>
                <dd>{project.tags?.[0] ?? "Case study"}</dd>
              </div>
            </dl>
          </div>
        </div>
      </a>
    ))}
  </div>

  <script>
    (() => {
      const init = () => {
        const filterButtons = Array.from(document.querySelectorAll("[data-filter]"));
        const projectCards = Array.from(document.querySelectorAll("[data-project-card]"));

        filterButtons.forEach((button) => {
          button.addEventListener("click", () => {
            const filter = button.getAttribute("data-filter") || "all";
            filterButtons.forEach((item) => item.classList.toggle("is-active", item === button));
            projectCards.forEach((card) => {
              const tags = (card.getAttribute("data-project-tags") || "").split("|");
              card.toggleAttribute("hidden", filter !== "all" && !tags.includes(filter));
            });
          });
        });
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init, { once: true });
      } else {
        init();
      }
    })();
  </script>
</section>

<style>
  .work-section {
    color: var(--ink);
    background: var(--paper);
    scroll-margin-top: 0;
  }

  .work-header {
    padding: clamp(1.15rem, 2vw, 1.75rem) var(--page-gutter);
    border-bottom: var(--rule);
  }

  .filter-group {
    margin: 0;
  }

  .project-filters {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    border-top: var(--rule);
    border-left: var(--rule);
  }

  .project-filter-btn {
    min-width: 0;
    min-height: 2.25rem;
    padding: 0.45rem 0.35rem;
    color: var(--ink);
    background: transparent;
    border: 0;
    border-right: var(--rule);
    border-bottom: var(--rule);
    border-radius: 0;
    font: inherit;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    text-align: center;
    transition:
      color 320ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 380ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-filter-btn:hover,
  .project-filter-btn:focus-visible,
  .project-filter-btn.is-active {
    color: #fff;
    background: var(--ink);
    outline: none;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-left: var(--rule);
    border-top: var(--rule);
  }

  .project-card {
    --project-footer-height: 4.6rem;
    position: relative;
    display: block;
    aspect-ratio: 1.15;
    overflow: hidden;
    color: #fff;
    background: #111;
    border-right: var(--rule);
    border-bottom: var(--rule);
    text-decoration: none;
  }

  .project-card[hidden] {
    display: none;
  }

  .project-card[data-project-slug="boca-paila"] {
    grid-column: 3;
    grid-row: 1 / span 2;
    aspect-ratio: auto;
  }

  .project-card img,
  .project-shade {
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    height: calc(100% - var(--project-footer-height));
  }

  .project-card img {
    object-fit: cover;
    transition:
      transform 650ms cubic-bezier(0.2, 0.75, 0.2, 1),
      filter 380ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card[data-project-slug="sidestreat"] img {
    object-position: right center;
  }

  .project-shade {
    background: linear-gradient(180deg, transparent 38%, rgba(0, 0, 0, 0.08) 55%, rgba(0, 0, 0, 0.78) 100%);
  }

  .project-label {
    position: absolute;
    inset: auto 0 0;
    background: rgba(8, 8, 8, 0.94);
    border-top: 1px solid rgba(255, 255, 255, 0.38);
    transform: translateY(calc(100% - var(--project-footer-height)));
    transition: transform 360ms cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .project-label-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.7rem;
    align-items: center;
    height: var(--project-footer-height);
    padding: 0 1rem;
  }

  .project-open {
    font-size: 0.65rem;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 2.3rem);
    font-weight: 650;
    line-height: 0.9;
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }

  .project-open {
    display: grid;
    width: 1.8rem;
    height: 1.8rem;
    place-items: center;
    color: var(--signal);
    background: transparent;
    border: 1px solid var(--signal);
  }

  .project-detail {
    min-height: 9rem;
    padding: 0 1rem 1.2rem;
  }

  .project-detail > p {
    max-width: 32rem;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .project-detail dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.1rem;
    padding-top: 0.8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
  }

  .project-detail dt {
    color: rgba(255, 255, 255, 0.42);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-detail dd {
    margin-top: 0.25rem;
    font-size: 0.68rem;
    font-weight: 600;
  }

  .project-card:hover img,
  .project-card:focus-visible img {
    filter: saturate(1.06) contrast(1.03);
    transform: scale(1.035);
  }

  .project-card:hover .project-label,
  .project-card:focus-visible .project-label {
    transform: translateY(0);
  }

  .project-card:focus-visible {
    outline: 4px solid var(--signal);
    outline-offset: -4px;
  }

  @media (max-width: 1050px) {
    .project-filters {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .project-card[data-project-slug="boca-paila"] {
      grid-column: 2;
    }

    .project-card:last-child:nth-child(odd) {
      grid-column: auto;
      aspect-ratio: 1.15;
    }
  }

  @media (max-width: 760px) {
    .work-section {
      scroll-margin-top: var(--mobile-header-height);
    }

  }

  @media (max-width: 600px) {
    .project-filters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .project-card,
    .project-card:last-child:nth-child(odd) {
      --project-footer-height: 4.1rem;
      grid-column: auto;
      aspect-ratio: 1.15;
    }

    .project-card[data-project-slug="boca-paila"] {
      grid-column: auto;
      grid-row: auto;
      aspect-ratio: 1.15;
    }
  }

  @media (hover: none) {
    .project-card {
      --project-footer-height: 4.1rem;
    }
  }
</style>
