---
import { getCollection } from "astro:content";

const entries = await getCollection("projects");
const preferredOrder = ["rguide", "chick-fil-a", "boca-paila", "chobani", "sidestreat", "3m-home-depot", "morgans", "nike-ko"];
const smallerOrder = ["54-hundred", "studio-d-vgs", "estrella-damm", "spirits-beverage"];
const projects = entries.map((entry) => ({ slug: entry.slug, ...entry.data }));
const featuredProjects = projects
  .filter((project) => project.cardSize === "featured")
  .sort((a, b) => {
    const aIndex = preferredOrder.indexOf(a.slug);
    const bIndex = preferredOrder.indexOf(b.slug);
    return (aIndex === -1 ? preferredOrder.length : aIndex)
      - (bIndex === -1 ? preferredOrder.length : bIndex);
  });
const smallerProjects = projects
  .filter((project) => project.cardSize === "small")
  .sort((a, b) => smallerOrder.indexOf(a.slug) - smallerOrder.indexOf(b.slug));

const filterTags = [
  "UI/UX",
  "Branding",
  "Retail",
  "Industrial Design",
  "Illustration",
  "Experience Design",
  "Advertising",
];
---

<section id="work" class="work-section" aria-label="Selected work">
  <header class="work-header">
    <div class="filter-group">
      <div class="project-filters" data-project-filters aria-label="Filter projects">
        <button type="button" class="project-filter-btn is-active" data-filter="all">All</button>
        {filterTags.map((tag) => (
          <button type="button" class="project-filter-btn" data-filter={tag.toLowerCase()}>{tag}</button>
        ))}
      </div>
    </div>
  </header>

  <div class="projects-grid">
    {featuredProjects.map((project, index) => (
      <a
        href={`/work/${project.slug}`}
        data-project-card
        data-project-slug={project.slug}
        data-project-tags={(project.tags || []).map((tag) => tag.toLowerCase()).join("|")}
        class="project-card"
      >
        <picture>
          {project.mobileCover && (
            <source media="(max-width: 600px)" srcset={project.mobileCover} />
          )}
          <img
            src={project.cover}
            alt={project.title}
            loading={index < 3 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : "auto"}
            decoding="async"
          />
        </picture>
        <span class="project-shade" aria-hidden="true"></span>
        <div class="project-label">
          <div class="project-label-heading">
            <h3>{project.title}</h3>
            <span class="project-open" aria-hidden="true">↗</span>
          </div>
          <div class="project-detail">
            <p>{project.description}</p>
            <dl>
              <div>
                <dt>Role</dt>
                <dd>{project.role ?? "Design"}</dd>
              </div>
              <div>
                <dt>Field</dt>
                <dd>{project.tags?.[0] ?? "Case study"}</dd>
              </div>
            </dl>
          </div>
        </div>
      </a>
    ))}
  </div>

  {smallerProjects.length > 0 && (
    <div id="more-work" class="more-projects" data-more-projects data-collapsed>
      <button type="button" class="more-projects-heading" aria-expanded="false" aria-controls="more-work-grid" data-more-projects-toggle>
        <span class="more-projects-title">More work</span>
        <span class="more-projects-meta">
          <span>{String(smallerProjects.length).padStart(2, "0")} projects</span>
          <span class="more-projects-preview" aria-hidden="true">
            <span class="more-projects-thumbnails">
              {smallerProjects.map((project) => (
                <img src={project.cover} alt="" loading="lazy" decoding="async" />
              ))}
            </span>
            <span class="more-projects-icon"></span>
          </span>
        </span>
      </button>
      <div id="more-work-grid" class="more-projects-content" data-more-projects-content inert aria-hidden="true">
        <div class="more-projects-grid">
          {smallerProjects.map((project) => (
            <a
              href={`/work/${project.slug}`}
              data-project-card
              data-project-tags={(project.tags || []).map((tag) => tag.toLowerCase()).join("|")}
              class="project-card project-card--small"
              aria-label={`View ${project.title} project`}
            >
              {project.previewImages?.length ? (
                <div class="project-card-media project-card-media--triptych">
                  {project.previewImages.map((src, index) => (
                    <img src={src} alt="" loading="lazy" decoding="async" style={`--image-order: ${index}`} />
                  ))}
                </div>
              ) : (
                <div class="project-card-media">
                  <img src={project.cover} alt="" loading="lazy" decoding="async" />
                </div>
              )}
              <div class="project-card-caption">
                <div>
                  <span>{project.tags[0] ?? "Project"}</span>
                  <h3>{project.title}</h3>
                </div>
                <span class="project-card-open" aria-hidden="true">↗</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  )}

  <script>
    (() => {
      const init = () => {
        const filterButtons = Array.from(document.querySelectorAll("[data-filter]"));
        const projectCards = Array.from(document.querySelectorAll("[data-project-card]"));
        const moreProjects = document.querySelector("[data-more-projects]");
        const moreProjectsToggle = moreProjects?.querySelector("[data-more-projects-toggle]");
        const moreProjectsContent = moreProjects?.querySelector("[data-more-projects-content]");
        const featuredGrid = document.querySelector(".projects-grid");

        const setMoreProjectsExpanded = (expanded) => {
          if (!moreProjects || !moreProjectsToggle || !moreProjectsContent) return;
          if (expanded) moreProjects.removeAttribute("data-preview-held");
          moreProjects.toggleAttribute("data-collapsed", !expanded);
          moreProjectsToggle.setAttribute("aria-expanded", String(expanded));
          moreProjectsContent.toggleAttribute("inert", !expanded);
          moreProjectsContent.toggleAttribute("aria-hidden", !expanded);
        };

        moreProjectsToggle?.addEventListener("click", () => {
          const expanded = moreProjects.hasAttribute("data-collapsed");
          moreProjects.toggleAttribute(
            "data-preview-held",
            !expanded && moreProjectsToggle.matches(":hover") && window.matchMedia("(hover: hover)").matches
          );
          setMoreProjectsExpanded(expanded);
        });

        moreProjectsToggle?.addEventListener("pointerleave", () => {
          moreProjects?.removeAttribute("data-preview-held");
        });

        filterButtons.forEach((button) => {
          button.addEventListener("click", () => {
            const filter = button.getAttribute("data-filter") || "all";
            filterButtons.forEach((item) => item.classList.toggle("is-active", item === button));
            projectCards.forEach((card) => {
              const tags = (card.getAttribute("data-project-tags") || "").split("|");
              card.toggleAttribute("hidden", filter !== "all" && !tags.includes(filter));
            });
            if (moreProjects) {
              const hasMatchingProjects = Array.from(moreProjects.querySelectorAll("[data-project-card]")).some(
                (card) => !card.hasAttribute("hidden")
              );
              moreProjects.toggleAttribute(
                "hidden",
                !hasMatchingProjects
              );
              if (hasMatchingProjects && filter !== "all") setMoreProjectsExpanded(true);
            }
            featuredGrid?.classList.toggle("is-filtered", filter !== "all");
          });
        });
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init, { once: true });
      } else {
        init();
      }
    })();
  </script>
</section>

<style>
  .work-section {
    color: var(--ink);
    background: var(--paper);
    scroll-margin-top: 0;
  }

  .work-header {
    padding: clamp(1.15rem, 2vw, 1.75rem) var(--page-gutter);
    border-bottom: var(--rule);
  }

  :global(html.has-js.is-page-loading) .work-header,
  :global(html.has-js) .work-header.motion-reveal {
    opacity: 1;
    clip-path: inset(0 0 100%);
    transform: translateY(-1.5rem);
    transition:
      clip-path 540ms cubic-bezier(0.76, 0, 0.24, 1),
      transform 580ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(html.has-js) .work-header.motion-reveal.is-revealed {
    opacity: 1;
    clip-path: inset(0);
    transform: translateY(0);
  }

  .filter-group {
    margin: 0;
  }

  .project-filters {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    border-top: var(--rule);
    border-left: var(--rule);
  }

  .project-filter-btn {
    min-width: 0;
    min-height: 2.25rem;
    padding: 0.45rem 0.35rem;
    color: var(--ink);
    background: transparent;
    border: 0;
    border-right: var(--rule);
    border-bottom: var(--rule);
    border-radius: 0;
    font: inherit;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    text-align: center;
    transition:
      color 320ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 380ms cubic-bezier(0.22, 1, 0.36, 1),
      clip-path 440ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 480ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(html.has-js) .work-header.motion-reveal .project-filter-btn {
    clip-path: inset(0 0 100%);
    transform: translateY(-0.9rem);
  }

  :global(html.has-js) .work-header.motion-reveal.is-revealed .project-filter-btn {
    clip-path: inset(0);
    transform: translateY(0);
  }

  :global(html.has-js) .work-header.motion-reveal.is-revealed .project-filter-btn:nth-child(1) { transition-delay: 0ms, 0ms, 80ms, 80ms; }
  :global(html.has-js) .work-header.motion-reveal.is-revealed .project-filter-btn:nth-child(2) { transition-delay: 0ms, 0ms, 125ms, 125ms; }
  :global(html.has-js) .work-header.motion-reveal.is-revealed .project-filter-btn:nth-child(3) { transition-delay: 0ms, 0ms, 170ms, 170ms; }
  :global(html.has-js) .work-header.motion-reveal.is-revealed .project-filter-btn:nth-child(4) { transition-delay: 0ms, 0ms, 215ms, 215ms; }
  :global(html.has-js) .work-header.motion-reveal.is-revealed .project-filter-btn:nth-child(5) { transition-delay: 0ms, 0ms, 260ms, 260ms; }
  :global(html.has-js) .work-header.motion-reveal.is-revealed .project-filter-btn:nth-child(6) { transition-delay: 0ms, 0ms, 305ms, 305ms; }
  :global(html.has-js) .work-header.motion-reveal.is-revealed .project-filter-btn:nth-child(7) { transition-delay: 0ms, 0ms, 350ms, 350ms; }
  :global(html.has-js) .work-header.motion-reveal.is-revealed .project-filter-btn:nth-child(8) { transition-delay: 0ms, 0ms, 395ms, 395ms; }

  .project-filter-btn:hover,
  .project-filter-btn:focus-visible,
  .project-filter-btn.is-active {
    color: #fff;
    background: var(--ink);
    outline: none;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-left: var(--rule);
    border-top: var(--rule);
  }

  .project-card {
    --project-footer-height: 4.6rem;
    position: relative;
    display: block;
    aspect-ratio: 1.15;
    overflow: hidden;
    color: #fff;
    background: #111;
    border-right: var(--rule);
    border-bottom: var(--rule);
    text-decoration: none;
  }

  :global(html.has-js.is-page-loading) .project-card,
  :global(html.has-js) .project-card.motion-reveal {
    opacity: 1;
    clip-path: var(--mosaic-clip, inset(0 0 100% 0));
    transform: translate3d(var(--mosaic-x, 0), var(--mosaic-y, 2.5rem), 0)
      scale(0.985)
      rotate(var(--mosaic-rotate, 0deg));
    transition:
      transform 650ms cubic-bezier(0.22, 1, 0.36, 1),
      clip-path 700ms cubic-bezier(0.76, 0, 0.24, 1);
    transition-delay: calc(var(--reveal-order, 0) * 50ms);
    will-change: transform, clip-path;
  }

  :global(html.has-js) .project-card.motion-reveal.is-revealed {
    opacity: 1;
    clip-path: inset(0);
    transform: translate3d(0, 0, 0) scale(1) rotate(0deg);
  }

  :global(html.has-js) .project-card:nth-child(1) {
    --mosaic-x: -2.75rem;
    --mosaic-y: 0;
    --mosaic-rotate: -0.7deg;
    --mosaic-clip: inset(0 100% 0 0);
  }

  :global(html.has-js) .project-card:nth-child(2) {
    --mosaic-x: 0;
    --mosaic-y: -2.75rem;
    --mosaic-rotate: 0.4deg;
    --mosaic-clip: inset(100% 0 0 0);
  }

  :global(html.has-js) .project-card:nth-child(3) {
    --mosaic-x: 2.75rem;
    --mosaic-y: 0;
    --mosaic-rotate: 0.7deg;
    --mosaic-clip: inset(0 0 0 100%);
  }

  :global(html.has-js) .project-card:nth-child(4) {
    --mosaic-x: -2.5rem;
    --mosaic-y: 0;
    --mosaic-rotate: 0.5deg;
    --mosaic-clip: inset(0 100% 0 0);
  }

  :global(html.has-js) .project-card:nth-child(5) {
    --mosaic-x: 0;
    --mosaic-y: 2.75rem;
    --mosaic-rotate: -0.5deg;
    --mosaic-clip: inset(0 0 100% 0);
  }

  :global(html.has-js) .project-card:nth-child(6) {
    --mosaic-x: 2.5rem;
    --mosaic-y: 0;
    --mosaic-rotate: 0.7deg;
    --mosaic-clip: inset(0 0 0 100%);
  }

  :global(html.has-js) .project-card:nth-child(7) {
    --mosaic-x: -2.75rem;
    --mosaic-y: 0;
    --mosaic-rotate: -0.6deg;
    --mosaic-clip: inset(0 100% 0 0);
  }

  :global(html.has-js) .project-card:nth-child(8) {
    --mosaic-x: 0;
    --mosaic-y: 2.75rem;
    --mosaic-rotate: 0.5deg;
    --mosaic-clip: inset(0 0 100% 0);
  }

  .project-card[hidden] {
    display: none;
  }

  .project-card[data-project-slug="boca-paila"] {
    grid-column: 3;
    grid-row: 1 / span 2;
    aspect-ratio: auto;
  }

  .projects-grid.is-filtered .project-card[data-project-slug="boca-paila"] {
    grid-column: auto;
    grid-row: auto;
    aspect-ratio: 1.15;
  }

  .project-card img,
  .project-shade {
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    height: calc(100% - var(--project-footer-height));
  }

  .project-card img {
    object-fit: cover;
    transition:
      transform 650ms cubic-bezier(0.2, 0.75, 0.2, 1),
      filter 380ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card[data-project-slug="sidestreat"] img {
    object-position: right center;
  }

  .project-shade {
    background: linear-gradient(180deg, transparent 38%, rgba(0, 0, 0, 0.08) 55%, rgba(0, 0, 0, 0.78) 100%);
  }

  .project-label {
    position: absolute;
    inset: auto 0 0;
    background: rgba(8, 8, 8, 0.94);
    transform: translateY(calc(100% - var(--project-footer-height)));
    transition: transform 360ms cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .project-label-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.7rem;
    align-items: center;
    height: var(--project-footer-height);
    padding: 0 1rem;
  }

  .project-open {
    font-size: 0.65rem;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 2.3rem);
    font-weight: 650;
    line-height: 0.9;
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }

  .project-open {
    display: grid;
    width: 1.8rem;
    height: 1.8rem;
    place-items: center;
    color: var(--signal);
    background: transparent;
    border: 1px solid var(--signal);
  }

  .project-detail {
    min-height: 9rem;
    padding: 0 1rem 1.2rem;
  }

  .project-detail > p {
    max-width: 32rem;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .project-detail dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.1rem;
    padding-top: 0.8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
  }

  .project-detail dt {
    color: rgba(255, 255, 255, 0.42);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-detail dd {
    margin-top: 0.25rem;
    font-size: 0.68rem;
    font-weight: 600;
  }

  .project-card:hover img,
  .project-card:focus-visible img {
    filter: saturate(1.06) contrast(1.03);
    transform: scale(1.035);
  }

  .project-card:hover .project-label,
  .project-card:focus-visible .project-label {
    transform: translateY(0);
  }

  .project-card:focus-visible {
    outline: 4px solid var(--signal);
    outline-offset: -4px;
  }

  @media (max-width: 1050px) {
    .project-filters {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .project-card[data-project-slug="boca-paila"] {
      grid-column: auto;
      grid-row: auto;
      aspect-ratio: 1.15;
    }

    .project-card:last-child:nth-child(odd) {
      grid-column: auto;
      aspect-ratio: 1.15;
    }
  }

  @media (max-width: 760px) {
    .work-section {
      scroll-margin-top: var(--mobile-header-height);
    }

  }

  @media (max-width: 600px) {
    .project-filters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .project-card,
    .project-card:last-child:nth-child(odd) {
      --project-footer-height: 4.1rem;
      grid-column: auto;
      aspect-ratio: 1.15;
    }

    .project-card[data-project-slug="boca-paila"] {
      grid-column: auto;
      grid-row: auto;
      aspect-ratio: 1.15;
    }
  }

  @media (hover: none) {
    .project-card {
      --project-footer-height: 4.1rem;
    }
  }

  .more-projects {
    scroll-margin-top: var(--mobile-header-height, 0);
  }

  .more-projects[hidden] {
    display: none;
  }

  .more-projects-heading {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.1rem;
    padding: 0.7rem 1rem;
    color: #fff;
    background: var(--ink);
    border: 0;
    border-bottom: var(--rule);
    border-radius: 0;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background-color 220ms ease;
  }

  .more-projects-heading:hover {
    background: #191919;
  }

  .more-projects-heading:focus-visible {
    outline: 3px solid var(--signal);
    outline-offset: -3px;
  }

  .more-projects-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.8rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }

  .more-projects-meta {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 2vw, 1.7rem);
    flex: none;
    color: var(--signal);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .more-projects-preview {
    --icon-size: 2rem;
    --thumb-size: var(--icon-size);
    --thumb-gap: 0.25rem;
    --thumb-step: calc(var(--thumb-size) + var(--thumb-gap));
    --icon-gap: 0.5rem;
    --preview-width: calc(var(--thumb-step) + var(--thumb-step) + var(--thumb-step) + var(--thumb-size) + var(--icon-gap) + var(--icon-size));
    position: relative;
    display: block;
    flex: none;
    width: var(--preview-width);
    height: var(--icon-size);
    transition: width 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .more-projects:not([data-collapsed]) .more-projects-preview,
  .more-projects[data-preview-held] .more-projects-preview {
    width: var(--icon-size);
  }

  .more-projects-thumbnails {
    position: absolute;
    top: 0;
    right: 0;
    width: var(--preview-width);
    height: 100%;
    pointer-events: none;
  }

  .more-projects-preview img {
    position: absolute;
    top: 50%;
    left: 0;
    width: var(--thumb-size);
    height: var(--thumb-size);
    border: 1px solid rgba(255, 255, 255, 0.65);
    object-fit: cover;
    opacity: 1;
    transform: translateY(-50%);
    transition:
      left 520ms cubic-bezier(0.22, 1, 0.36, 1) var(--exit-delay, 0ms),
      opacity 160ms ease 80ms;
  }

  .more-projects:not([data-collapsed]) .more-projects-preview img,
  .more-projects[data-preview-held] .more-projects-preview img {
    left: calc(100% - var(--thumb-size));
    opacity: 0;
    visibility: hidden;
    /* Keep the images behind the icon until the pointer leaves after collapse. */
    transition: none;
  }

  .more-projects-preview img:nth-child(2) {
    left: var(--thumb-step);
    --enter-delay: 120ms;
    --exit-delay: 60ms;
  }

  .more-projects-preview img:nth-child(3) {
    left: calc(var(--thumb-step) + var(--thumb-step));
    --enter-delay: 60ms;
    --exit-delay: 120ms;
  }

  .more-projects-preview img:nth-child(4) {
    left: calc(var(--thumb-step) + var(--thumb-step) + var(--thumb-step));
    --exit-delay: 180ms;
  }

  .more-projects-preview img:first-child {
    --enter-delay: 180ms;
  }

  @media (min-width: 601px) {
    .more-projects[data-collapsed] .more-projects-heading:is(:hover, :focus-visible) .more-projects-preview {
      width: var(--icon-size);
      transition: width 700ms cubic-bezier(0.65, 0, 0.35, 1);
    }

    .more-projects[data-collapsed] .more-projects-heading:is(:hover, :focus-visible) .more-projects-preview img {
      left: calc(100% - var(--thumb-size));
      transition-delay: var(--enter-delay, 0ms);
    }
  }

  .more-projects-icon {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 0;
    display: grid;
